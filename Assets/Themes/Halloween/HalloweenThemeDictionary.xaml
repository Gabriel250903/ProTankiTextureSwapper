<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <FontFamily x:Key="HalloweenSpookyFont">
        pack://application:,,,/TextureSwapper;component/Assets/Themes/Halloween/#Creepster, ./Assets/Themes/Halloween/#Creepster, Creepster
    </FontFamily>
    <FontFamily x:Key="ActiveDisplayFont">
        pack://application:,,,/TextureSwapper;component/Assets/Themes/Halloween/#Creepster, ./Assets/Themes/Halloween/#Creepster, Creepster
    </FontFamily>

    <Color x:Key="HalloweenPrimaryColor">#FFFF6B00</Color>
    <Color x:Key="HalloweenSecondaryColor">#FF9B51E0</Color>
    <Color x:Key="HalloweenDarkVioletColor">#FF09040E</Color>
    <Color x:Key="HalloweenCardColor">#E6140722</Color>
    <Color x:Key="HalloweenCardStrokeColor">#FFFF6B00</Color>

    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource HalloweenPrimaryColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource HalloweenDarkVioletColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource HalloweenCardColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource HalloweenCardStrokeColor}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#CC1E0A30" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF3D1504" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#B312061E" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF8F0" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#D9D0C7" />

    <SolidColorBrush x:Key="HalloweenAccentBrush" Color="{StaticResource HalloweenPrimaryColor}" />
    <SolidColorBrush x:Key="HalloweenSecondaryBrush" Color="{StaticResource HalloweenSecondaryColor}" />
    <SolidColorBrush x:Key="HalloweenDarkVioletBrush" Color="{StaticResource HalloweenDarkVioletColor}" />
    <SolidColorBrush x:Key="HalloweenCardBorderBrush" Color="{StaticResource HalloweenCardStrokeColor}" />
    <SolidColorBrush x:Key="HalloweenMoonBrush" Color="#FFEE9900" />
    <SolidColorBrush x:Key="HalloweenGhostBrush" Color="#C0D5C4FA" />

    <Style x:Key="HalloweenHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HalloweenSpookyFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource HalloweenAccentBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="8"
                    Opacity="0.6"
                    ShadowDepth="0"
                    Color="#FFFF6B00" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HalloweenSubHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HalloweenSpookyFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="#FFFF9933" />
    </Style>

    <Style x:Key="HalloweenModPillButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="#FF220C33" />
        <Setter Property="Foreground" Value="#FFFF6B00" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#80FF6B00" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="HalloweenCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HalloweenAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.35"
                    ShadowDepth="0"
                    Color="#9B51E0" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}" TargetType="ui:NavigationViewItem">
        <Setter Property="FontFamily" Value="{StaticResource HalloweenSpookyFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
</ResourceDictionary>

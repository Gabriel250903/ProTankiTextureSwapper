<UserControl
  x:Class="TextureSwapper.Views.Controls.AdminOverlayControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:TextureSwapper.Helpers.Converters"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:TextureSwapper.ViewModels"
  d:DataContext="{d:DesignInstance vm:MainViewModel,
                                     IsDesignTimeCreatable=False}"
  mc:Ignorable="d"
>
  <UserControl.Resources>
    <Style x:Key="ActionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Border"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
            >
              <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Symbol="MoreHorizontal24" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="Border"
                  Property="Background"
                  Value="{DynamicResource ControlFillColorSecondaryBrush}"
                />
                <Setter
                  TargetName="Border"
                  Property="BorderBrush"
                  Value="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter
                  TargetName="Border"
                  Property="Background"
                  Value="{DynamicResource ControlFillColorTertiaryBrush}"
                />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RowIconButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border
              x:Name="Border"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              CornerRadius="4"
            >
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter
                  TargetName="Border"
                  Property="Background"
                  Value="{DynamicResource ControlFillColorSecondaryBrush}"
                />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter
                  TargetName="Border"
                  Property="Background"
                  Value="{DynamicResource ControlFillColorTertiaryBrush}"
                />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="#99000000">
    <Border
      MaxWidth="380"
      Margin="0,20,20,0"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Panel.ZIndex="3000"
      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1.5"
      CornerRadius="8"
      Visibility="{Binding IsOpen, ElementName=AdminToastInfoBar, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border.Effect>
        <DropShadowEffect
          BlurRadius="18"
          Direction="270"
          Opacity="0.65"
          ShadowDepth="4"
          Color="Black" />
      </Border.Effect>
      <ui:InfoBar
        x:Name="AdminToastInfoBar"
        Background="Transparent"
        BorderThickness="0"
        IsClosable="False"
        IsOpen="False" />
    </Border>

    <Border
      x:Name="LoginPanel"
      Width="400"
      Height="330"
      Padding="28"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="12"
    >
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding AdminVM.IsAuthenticated}" Value="False">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" Opacity="0.4" ShadowDepth="0" Color="Black" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
          <ui:TextBlock
            HorizontalAlignment="Center"
            FontTypography="Subtitle"
            FontWeight="Bold"
            Text="{DynamicResource Loc_Admin_AuthTitle}"
          />
          <ui:TextBlock
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            FontTypography="Caption"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{DynamicResource Loc_Admin_AuthDesc}"
          />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <ui:PasswordBox
            x:Name="AdminPasswordBox"
            Margin="0,0,0,10"
            KeyDown="AdminPasswordBox_KeyDown"
            PlaceholderText="{DynamicResource Loc_Admin_PasswordPlaceholder}"
          />
          <Border
            Margin="0,0,0,12"
            Padding="10,6"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
          >
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ui:TextBlock
                  FontTypography="Caption"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{DynamicResource Loc_Admin_YourHwid}"
                />
                <ui:TextBlock
                  FontFamily="Consolas, Courier New, monospace"
                  FontSize="11"
                  FontWeight="SemiBold"
                  Text="{Binding AdminVM.CurrentHardwareId}"
                  TextTrimming="CharacterEllipsis"
                />
              </StackPanel>
              <ui:Button
                Grid.Column="1"
                Margin="6,0,0,0"
                Padding="8,4"
                Command="{Binding AdminVM.CopyKeyCommand}"
                CommandParameter="{Binding AdminVM.CurrentHardwareId}"
                ToolTip="Copy Device HWID"
              >
                <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
              </ui:Button>
            </Grid>
          </Border>
          <CheckBox
            Margin="2,0,0,10"
            Content="{DynamicResource Loc_Admin_RememberPc}"
            FontSize="12"
            IsChecked="{Binding AdminVM.RememberPassword}"
          />
        </StackPanel>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:Button
            Grid.Column="0"
            Margin="0,0,6,0"
            HorizontalAlignment="Stretch"
            Click="OnCancelAdminLogin"
            Content="{DynamicResource Loc_Admin_Cancel}"
          />
          <ui:Button
            Grid.Column="1"
            Margin="6,0,0,0"
            HorizontalAlignment="Stretch"
            Appearance="Primary"
            Command="{Binding AdminVM.LoginCommand}"
            CommandParameter="{Binding ElementName=AdminPasswordBox}"
            Content="{DynamicResource Loc_Admin_Login}"
          />
        </Grid>
      </Grid>
    </Border>

    <Border
      x:Name="DashboardPanel"
      Margin="40"
      Padding="28"
      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="16"
    >
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding AdminVM.IsAuthenticated}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.Effect>
        <DropShadowEffect BlurRadius="40" Opacity="0.4" ShadowDepth="0" Color="Black" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Border
              Width="4"
              Height="38"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemAccentColorBrush}"
              CornerRadius="2"
            />
            <StackPanel VerticalAlignment="Center">
              <ui:TextBlock
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"
                Text="{DynamicResource Loc_Admin_DashboardTitle}"
              />
              <ui:TextBlock
                FontTypography="Caption"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource Loc_Admin_DashboardDesc}"
              />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
            <ui:Button
              Margin="0,0,8,0"
              Appearance="Primary"
              Command="{Binding AdminVM.SaveChangesCommand}"
              Content="{DynamicResource Loc_Admin_SaveChanges}"
              Icon="{ui:SymbolIcon Save24}"
            />
            <ui:Button
              Margin="0,0,8,0"
              Appearance="Secondary"
              Command="{Binding AdminVM.LogoutCommand}"
              Content="{DynamicResource Loc_Admin_Lock}"
              Icon="{ui:SymbolIcon LockClosed24}"
              ToolTip="{DynamicResource Loc_Admin_LockTooltip}"
            />
            <ui:Button
              Appearance="Secondary"
              Command="{Binding AdminVM.CancelCommand}"
              Content="{DynamicResource Loc_Admin_Close}"
              Icon="{ui:SymbolIcon Dismiss24}"
            />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border
            Grid.Column="0"
            Margin="0,0,20,0"
            Padding="12"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
          >
            <StackPanel>
              <ui:TextBlock
                Margin="0,0,0,12"
                FontTypography="Caption"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource Loc_Admin_Navigation}"
              />

              <ui:Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Command="{Binding AdminVM.SelectTabCommand}"
                CommandParameter="Paints"
                Content="{DynamicResource Loc_Admin_PaintsManager}"
                Icon="{ui:SymbolIcon PaintBrush24}"
              >
                <ui:Button.Style>
                  <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                    <Setter Property="Appearance" Value="Secondary" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding AdminVM.IsPaintsTabSelected}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>

              <ui:Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Appearance="Secondary"
                Command="{Binding AdminVM.SelectTabCommand}"
                CommandParameter="Licenses"
                Content="{DynamicResource Loc_Admin_LicenseManager}"
                Icon="{ui:SymbolIcon Key24}"
              >
                <ui:Button.Style>
                  <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                    <Setter Property="Appearance" Value="Secondary" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding AdminVM.IsLicensesTabSelected}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>

              <ui:Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Appearance="Secondary"
                Command="{Binding AdminVM.SelectTabCommand}"
                CommandParameter="Bans"
                Content="{DynamicResource Loc_Admin_DeviceBans}"
                Icon="{ui:SymbolIcon ShieldDismiss24}"
              >
                <ui:Button.Style>
                  <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                    <Setter Property="Appearance" Value="Secondary" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding AdminVM.IsBansTabSelected}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>

              <ui:Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Appearance="Secondary"
                Command="{Binding AdminVM.SelectTabCommand}"
                CommandParameter="Logs"
                Content="{DynamicResource Loc_Admin_SystemLogs}"
                Icon="{ui:SymbolIcon DocumentBulletList24}"
              >
                <ui:Button.Style>
                  <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                    <Setter Property="Appearance" Value="Secondary" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding AdminVM.IsLogsTabSelected}" Value="True">
                        <Setter Property="Appearance" Value="Primary" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>
            </StackPanel>
          </Border>

          <Grid Grid.Column="1">
            <Grid Visibility="{Binding AdminVM.IsPaintsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <Border
                  Grid.Column="0"
                  Margin="0,0,16,0"
                  Padding="14,12"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                >
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
                      <ui:SymbolIcon
                        Margin="0,0,6,0"
                        FontSize="16"
                        Foreground="{DynamicResource SystemAccentColorBrush}"
                        Symbol="Search24"
                      />
                      <ui:TextBlock
                        FontWeight="SemiBold"
                        Text="{DynamicResource Loc_Admin_FilterPaints}"
                      />
                    </StackPanel>

                    <Grid Grid.Row="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBox
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{DynamicResource Loc_Admin_SearchPaintsPlaceholder}"
                        Text="{Binding AdminVM.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      />
                      <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AdminVM.FilterCategories}"
                        SelectedItem="{Binding AdminVM.SelectedFilterCategory, Mode=TwoWay}"
                      />
                    </Grid>
                  </Grid>
                </Border>

                <Border
                  Grid.Column="1"
                  Padding="14,12"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                >
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
                      <ui:SymbolIcon
                        Margin="0,0,6,0"
                        FontSize="16"
                        Foreground="{DynamicResource SystemAccentColorBrush}"
                        Symbol="Tag24"
                      />
                      <ui:TextBlock
                        FontWeight="SemiBold"
                        Text="{DynamicResource Loc_Admin_CategoryManagement}"
                      />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBox
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        PlaceholderText="{DynamicResource Loc_Admin_NewCategoryPlaceholder}"
                        Text="{Binding AdminVM.NewCategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      />
                      <ui:Button
                        Grid.Column="1"
                        Padding="12,6"
                        Appearance="Primary"
                        Command="{Binding AdminVM.AddCategoryCommand}"
                        Content="{DynamicResource Loc_Admin_Add}"
                        Icon="{ui:SymbolIcon Add24}"
                      />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ComboBox
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        ItemsSource="{Binding AdminVM.ExistingItemNames}"
                        SelectedItem="{Binding AdminVM.SelectedCategoryToRename, Mode=TwoWay}"
                      />
                      <ui:TextBox
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        PlaceholderText="{DynamicResource Loc_Admin_RenameToPlaceholder}"
                        Text="{Binding AdminVM.RenameCategoryNewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      />
                      <ui:Button
                        Grid.Column="2"
                        Padding="10,6"
                        Appearance="Secondary"
                        Command="{Binding AdminVM.RenameCategoryCommand}"
                        Content="{DynamicResource Loc_Admin_Rename}"
                        Icon="{ui:SymbolIcon Edit24}"
                      />
                    </Grid>

                    <Grid Grid.Row="3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ComboBox
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding AdminVM.ExistingItemNames}"
                        SelectedItem="{Binding AdminVM.SelectedCategoryToRemove, Mode=TwoWay}"
                      />
                      <ui:Button
                        Grid.Column="1"
                        Padding="12,6"
                        Appearance="Danger"
                        Command="{Binding AdminVM.RemoveCategoryCommand}"
                        Content="{DynamicResource Loc_Admin_Delete}"
                        Icon="{ui:SymbolIcon Delete24}"
                      />
                    </Grid>
                  </Grid>
                </Border>
              </Grid>

              <ListView
                Grid.Row="1"
                Margin="0,0,0,16"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding AdminVM.FilteredPaints}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
              >
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border
                      Padding="12,10"
                      Background="{DynamicResource ControlFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                    >
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="60" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <Border
                          Grid.Column="0"
                          Width="44"
                          Height="44"
                          Background="{DynamicResource ControlFillColorTertiaryBrush}"
                          ClipToBounds="True"
                          CornerRadius="6"
                        >
                          <Image
                            Source="{Binding FullPreviewPath, Converter={StaticResource ImageThumbnailConverter}, IsAsync=True, TargetNullValue={x:Null}}"
                            Stretch="UniformToFill"
                          />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                          <ui:TextBlock
                            FontSize="14"
                            FontTypography="BodyStrong"
                            Foreground="White"
                            Text="{Binding Name}"
                          />
                          <ui:TextBlock
                            Margin="0,2,0,0"
                            FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SourceFolder, StringFormat='Folder: {0}'}"
                          />
                        </StackPanel>
                        <ComboBox
                          Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          IsEditable="False"
                          ItemsSource="{Binding DataContext.AdminVM.ExistingItemNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>

              <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock
                  Grid.Column="0"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding AdminVM.FilteredPaints.Count, StringFormat='Showing {0} paints'}"
                />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ui:Button
                    Margin="0,0,12,0"
                    Click="OnCloseAdminDashboard"
                    Content="{DynamicResource Loc_Admin_Cancel}"
                  />
                  <ui:Button
                    Appearance="Success"
                    Command="{Binding AdminVM.SaveChangesCommand}"
                    Content="{DynamicResource Loc_Admin_SaveChanges}"
                    FontWeight="Bold"
                  />
                </StackPanel>
              </Grid>
            </Grid>

            <ScrollViewer
              Grid.Row="0"
              VerticalScrollBarVisibility="Auto"
              Visibility="{Binding AdminVM.IsLicensesTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
            >
              <StackPanel>
                <ui:Card Margin="0,0,0,16" Padding="20">
                  <StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                      <ui:SymbolIcon
                        Margin="0,0,10,0"
                        Filled="True"
                        Foreground="#FF5555"
                        Symbol="Key24"
                      />
                      <ui:TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{DynamicResource Loc_Admin_LicenseKeys}"
                      />
                    </StackPanel>
                  </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,16" Padding="20">
                  <StackPanel>
                    <WrapPanel Margin="0,0,0,16" VerticalAlignment="Center">
                      <ui:TextBox
                        MinWidth="200"
                        Margin="0,0,12,8"
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{DynamicResource Loc_Admin_SearchLicensesPlaceholder}"
                        Text="{Binding AdminVM.LicenseSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      />

                      <ComboBox
                        MinWidth="130"
                        Margin="0,0,12,8"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AdminVM.LicenseStatusFilters}"
                        SelectedItem="{Binding AdminVM.SelectedLicenseStatusFilter, Mode=TwoWay}"
                      />

                      <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <ui:Button
                          Margin="0,0,8,0"
                          Appearance="Primary"
                          Command="{Binding AdminVM.GenerateKeyCommand}"
                          Content="{DynamicResource Loc_Admin_GenerateKey}"
                          Icon="{ui:SymbolIcon Add24}"
                        />
                        <ui:Button
                          Margin="0,0,8,0"
                          Appearance="Secondary"
                          Command="{Binding AdminVM.ExportCsvCommand}"
                          Content="{DynamicResource Loc_Admin_ExportCsv}"
                          Icon="{ui:SymbolIcon DocumentArrowDown24}"
                        />
                        <ui:Button
                          Appearance="Secondary"
                          Command="{Binding AdminVM.RefreshKeysCommand}"
                          Content="{DynamicResource Loc_Admin_Refresh}"
                          Icon="{ui:SymbolIcon ArrowClockwise24}"
                        />
                        <ui:ProgressRing
                          Width="20"
                          Height="20"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          IsIndeterminate="True"
                          Visibility="{Binding AdminVM.IsLoadingKeys, Converter={StaticResource BooleanToVisibilityConverter}}"
                        />
                      </StackPanel>
                    </WrapPanel>

                    <Border
                      Margin="0,0,0,8"
                      Padding="12,10"
                      Background="#1AFFFFFF"
                      CornerRadius="6"
                    >
                      <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2.2*" MinWidth="160" />
                          <ColumnDefinition Width="1.2*" MinWidth="90" />
                          <ColumnDefinition Width="2.5*" MinWidth="140" />
                          <ColumnDefinition Width="1.1*" MinWidth="85" />
                          <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>

                        <ui:Button
                          Grid.Column="0"
                          Padding="0"
                          HorizontalAlignment="Left"
                          Background="Transparent"
                          BorderThickness="0"
                          Command="{Binding AdminVM.SortCommand}"
                          CommandParameter="LicenseKey"
                        >
                          <StackPanel Orientation="Horizontal">
                            <ui:TextBlock
                              FontTypography="Caption"
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{DynamicResource Loc_Admin_ColKey}"
                            />
                            <ui:TextBlock
                              FontTypography="Caption"
                              FontWeight="Bold"
                              Foreground="{DynamicResource SystemAccentColorBrush}"
                              Text="{Binding AdminVM.SortIndicatorLicenseKey}"
                            />
                          </StackPanel>
                        </ui:Button>

                        <ui:Button
                          Grid.Column="1"
                          Padding="0"
                          HorizontalAlignment="Left"
                          Background="Transparent"
                          BorderThickness="0"
                          Command="{Binding AdminVM.SortCommand}"
                          CommandParameter="Nickname"
                        >
                          <StackPanel Orientation="Horizontal">
                            <ui:TextBlock
                              FontTypography="Caption"
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{DynamicResource Loc_Admin_ColNickname}"
                            />
                            <ui:TextBlock
                              FontTypography="Caption"
                              FontWeight="Bold"
                              Foreground="{DynamicResource SystemAccentColorBrush}"
                              Text="{Binding AdminVM.SortIndicatorNickname}"
                            />
                          </StackPanel>
                        </ui:Button>

                        <ui:Button
                          Grid.Column="2"
                          Padding="0"
                          HorizontalAlignment="Left"
                          Background="Transparent"
                          BorderThickness="0"
                          Command="{Binding AdminVM.SortCommand}"
                          CommandParameter="Hwid"
                        >
                          <StackPanel Orientation="Horizontal">
                            <ui:TextBlock
                              FontTypography="Caption"
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{DynamicResource Loc_Admin_ColHwid}"
                            />
                            <ui:TextBlock
                              FontTypography="Caption"
                              FontWeight="Bold"
                              Foreground="{DynamicResource SystemAccentColorBrush}"
                              Text="{Binding AdminVM.SortIndicatorHwid}"
                            />
                          </StackPanel>
                        </ui:Button>

                        <ui:Button
                          Grid.Column="3"
                          Padding="0"
                          HorizontalAlignment="Left"
                          Background="Transparent"
                          BorderThickness="0"
                          Command="{Binding AdminVM.SortCommand}"
                          CommandParameter="Status"
                        >
                          <StackPanel Orientation="Horizontal">
                            <ui:TextBlock
                              FontTypography="Caption"
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="{DynamicResource Loc_Admin_ColStatus}"
                            />
                            <ui:TextBlock
                              FontTypography="Caption"
                              FontWeight="Bold"
                              Foreground="{DynamicResource SystemAccentColorBrush}"
                              Text="{Binding AdminVM.SortIndicatorStatus}"
                            />
                          </StackPanel>
                        </ui:Button>

                        <ui:TextBlock
                          Grid.Column="4"
                          HorizontalAlignment="Right"
                          FontTypography="Caption"
                          FontWeight="Bold"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{DynamicResource Loc_Admin_ColActions}"
                        />
                      </Grid>
                    </Border>

                    <ListView
                      Height="300"
                      Background="Transparent"
                      BorderThickness="0"
                      ItemsSource="{Binding AdminVM.PagedServerKeys}"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                    >
                      <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                          <Setter Property="Background" Value="Transparent" />
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Margin" Value="0,0,0,6" />
                          <Setter Property="Focusable" Value="False" />
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListView.ItemContainerStyle>
                      <ListView.ItemTemplate>
                        <DataTemplate>
                          <Border
                            Padding="12,10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                          >
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" MinWidth="160" />
                                <ColumnDefinition Width="1.2*" MinWidth="90" />
                                <ColumnDefinition Width="2.5*" MinWidth="140" />
                                <ColumnDefinition Width="1.1*" MinWidth="85" />
                                <ColumnDefinition Width="110" />
                              </Grid.ColumnDefinitions>

                              <Grid Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock
                                  Grid.Column="0"
                                  FontSize="13"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Text="{Binding LicenseKey}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip="{Binding LicenseKey}"
                                />
                                <Button
                                  Grid.Column="1"
                                  Margin="4,0,0,0"
                                  Command="{Binding DataContext.AdminVM.CopyKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding LicenseKey}"
                                  Style="{StaticResource RowIconButtonStyle}"
                                  ToolTip="Copy License Key"
                                >
                                  <ui:SymbolIcon Symbol="Copy16" />
                                </Button>
                              </Grid>
                              <ui:TextBlock
                                Grid.Column="1"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="White"
                                Text="{Binding Nickname, TargetNullValue='—'}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Nickname}"
                              />
                              <ui:TextBlock
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#CCCCCC"
                                Text="{Binding Hwid, TargetNullValue='Not bound'}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Hwid}"
                              />
                              <Border
                                Grid.Column="3"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="6"
                                ToolTip="{Binding FormattedExpires, StringFormat='Expires: {0}'}"
                              >
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2038BDF8" />
                                    <Setter Property="BorderBrush" Value="#8038BDF8" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="#2000FF7F" />
                                        <Setter Property="BorderBrush" Value="#8000FF7F" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsRevoked}" Value="True">
                                        <Setter Property="Background" Value="#25FF453A" />
                                        <Setter Property="BorderBrush" Value="#80FF453A" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                        <Setter Property="Background" Value="#25FF9F0A" />
                                        <Setter Property="BorderBrush" Value="#80FF9F0A" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <ui:TextBlock
                                  FontSize="11"
                                  FontWeight="Bold"
                                  Text="{Binding Status}"
                                >
                                  <ui:TextBlock.Style>
                                    <Style TargetType="ui:TextBlock">
                                      <Setter Property="Foreground" Value="#38BDF8" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                          <Setter Property="Foreground" Value="#00FF7F" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRevoked}" Value="True">
                                          <Setter Property="Foreground" Value="#FF453A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                          <Setter Property="Foreground" Value="#FF9F0A" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </ui:TextBlock.Style>
                                </ui:TextBlock>
                              </Border>
                              <Button
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnActionsButtonClick"
                                Content="Actions"
                                Style="{StaticResource ActionButtonStyle}"
                                Tag="{Binding DataContext.AdminVM, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              >
                                <Button.ContextMenu>
                                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.OpenAssignKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Header="Assign Key..."
                                      Icon="{ui:SymbolIcon PersonKey24}"
                                    />
                                    <Separator />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.RevokeKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding LicenseKey}"
                                      Header="Revoke Key"
                                    >
                                      <MenuItem.Icon>
                                        <ui:SymbolIcon Foreground="#FF4D4D" Symbol="Dismiss16" />
                                      </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.UnbindHwidCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding LicenseKey}"
                                      Header="Unbind HWID"
                                      IsEnabled="{Binding CanUnbind}"
                                      ToolTip="Unbinds the hardware ID (HWID) bound to this license key, allowing the user to activate on a new device."
                                    >
                                      <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="ArrowClockwise16" />
                                      </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.DeleteKeyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding LicenseKey}"
                                      Foreground="#FF4D4D"
                                      Header="Delete Key"
                                      ToolTip="Permanently deletes this license key from the server database."
                                    >
                                      <MenuItem.Icon>
                                        <ui:SymbolIcon Foreground="#FF4D4D" Symbol="Delete24" />
                                      </MenuItem.Icon>
                                    </MenuItem>
                                  </ContextMenu>
                                </Button.ContextMenu>
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListView.ItemTemplate>
                    </ListView>

                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      >
                        <ui:TextBlock.Text>
                          <MultiBinding StringFormat="Page {0} of {1} (Total: {2} keys)">
                            <Binding Path="AdminVM.CurrentKeysPage" />
                            <Binding Path="AdminVM.TotalKeysPages" />
                            <Binding Path="AdminVM.TotalServerKeysCount" />
                          </MultiBinding>
                        </ui:TextBlock.Text>
                      </ui:TextBlock>

                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button
                          Margin="0,0,8,0"
                          Command="{Binding AdminVM.PrevKeysPageCommand}"
                          Content="Previous"
                          Icon="{ui:SymbolIcon ChevronLeft24}"
                        />
                        <ui:Button
                          Command="{Binding AdminVM.NextKeysPageCommand}"
                          Content="Next"
                          Icon="{ui:SymbolIcon ChevronRight24}"
                        />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </ui:Card>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer
              Grid.Row="0"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              Visibility="{Binding AdminVM.IsBansTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
            >
              <StackPanel MinWidth="750" Margin="0,0,10,0">
                <ui:Card Margin="0,0,0,16" Padding="20">
                  <StackPanel>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                      <ui:SymbolIcon
                        Margin="0,0,10,0"
                        Filled="True"
                        Foreground="#FF453A"
                        Symbol="ShieldDismiss24"
                      />
                      <ui:TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Device Ban &amp; HWID Gatekeeper"
                      />
                    </StackPanel>
                    <ui:TextBlock
                      Margin="0,0,0,14"
                      FontTypography="Caption"
                      Opacity="0.7"
                      Text="Manage all devices that have accessed TextureSwapper. Apply permanent or temporary bans directly via Cloudflare Edge."
                    />

                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <ui:TextBox
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        ClearButtonEnabled="True"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="Filter by HWID, IP, reason, or status..."
                        Text="{Binding AdminVM.DeviceFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      />

                      <ui:Button
                        Grid.Column="1"
                        Appearance="Primary"
                        Command="{Binding AdminVM.RefreshDevicesCommand}"
                        Content="Refresh Devices"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                      />
                    </Grid>

                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBlock
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        FontWeight="SemiBold"
                        Text="Reason for new bans:"
                      />
                      <ui:TextBox
                        Grid.Column="1"
                        PlaceholderText="Enter reason (e.g. Violation of community terms)..."
                        Text="{Binding AdminVM.BanReasonInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      />
                    </Grid>
                  </StackPanel>
                </ui:Card>

                <ui:Card Padding="16">
                  <StackPanel>
                    <Border
                      Margin="0,0,0,8"
                      Padding="12,8"
                      Background="{DynamicResource ControlFillColorSecondaryBrush}"
                      CornerRadius="8"
                    >
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="165" />
                          <ColumnDefinition Width="*" MinWidth="180" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                          Grid.Column="0"
                          FontTypography="Caption"
                          FontWeight="Bold"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="STATUS"
                        />
                        <ui:TextBlock
                          Grid.Column="1"
                          FontTypography="Caption"
                          FontWeight="Bold"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="HARDWARE IDENTIFIER (HWID)"
                        />
                        <ui:TextBlock
                          Grid.Column="2"
                          FontTypography="Caption"
                          FontWeight="Bold"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="IP ADDRESS"
                        />
                        <ui:TextBlock
                          Grid.Column="3"
                          FontTypography="Caption"
                          FontWeight="Bold"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="LAST SEEN"
                        />
                        <ui:TextBlock
                          Grid.Column="4"
                          HorizontalAlignment="Right"
                          FontTypography="Caption"
                          FontWeight="Bold"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="ACTIONS"
                        />
                      </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding AdminVM.FilteredDevices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border
                            Margin="0,0,0,6"
                            Padding="12,10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                          >
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165" />
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="120" />
                              </Grid.ColumnDefinitions>

                              <Border
                                Grid.Column="0"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="6"
                              >
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2500FF7F" />
                                    <Setter Property="BorderBrush" Value="#8000FF7F" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsTempBan}" Value="True">
                                        <Setter Property="Background" Value="#25FF9F0A" />
                                        <Setter Property="BorderBrush" Value="#80FF9F0A" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding IsPermanentBan}" Value="True">
                                        <Setter Property="Background" Value="#25FF3B30" />
                                        <Setter Property="BorderBrush" Value="#80FF3B30" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <ui:TextBlock
                                  FontSize="11"
                                  FontWeight="Bold"
                                  Text="{Binding StatusDisplay}"
                                >
                                  <ui:TextBlock.Style>
                                    <Style TargetType="ui:TextBlock">
                                      <Setter Property="Foreground" Value="#00FF7F" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTempBan}" Value="True">
                                          <Setter Property="Foreground" Value="#FF9F0A" />
                                        </DataTrigger>
                                        <DataTrigger
                                          Binding="{Binding IsPermanentBan}"
                                          Value="True"
                                        >
                                          <Setter Property="Foreground" Value="#FF453A" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </ui:TextBlock.Style>
                                </ui:TextBlock>
                              </Border>

                              <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                              >
                                <ui:TextBlock
                                  VerticalAlignment="Center"
                                  FontFamily="Consolas, monospace"
                                  FontSize="11"
                                  Text="{Binding ShortHwid}"
                                  ToolTip="{Binding Hwid}"
                                />
                                <Button
                                  Margin="8,0,0,0"
                                  Command="{Binding DataContext.AdminVM.CopyHwidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  Style="{StaticResource RowIconButtonStyle}"
                                  ToolTip="Copy Full HWID"
                                >
                                  <ui:SymbolIcon FontSize="14" Symbol="Copy24" />
                                </Button>
                              </StackPanel>

                              <ui:TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, monospace"
                                FontSize="11"
                                Opacity="0.8"
                                Text="{Binding IpAddress}"
                              />

                              <ui:TextBlock
                                Grid.Column="3"
                                Margin="10"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Opacity="0.7"
                                Text="{Binding LastSeen}"
                                TextTrimming="CharacterEllipsis"
                              />

                              <Button
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnActionsButtonClick"
                                Content="Actions"
                                Style="{StaticResource ActionButtonStyle}"
                                Tag="{Binding DataContext.AdminVM, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              >
                                <Button.ContextMenu>
                                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.ViewDeviceProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Header="View Profile"
                                      Icon="{ui:SymbolIcon Person24}"
                                    />
                                    <Separator />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.Ban1DayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Header="Ban for 24 Hours (Temporary)"
                                      Icon="{ui:SymbolIcon Clock24}"
                                    />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.Ban7DaysCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Header="Ban for 7 Days (Temporary)"
                                      Icon="{ui:SymbolIcon CalendarDay24}"
                                    />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.BanPermanentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      FontWeight="SemiBold"
                                      Foreground="#FF453A"
                                      Header="Permanent HWID Ban"
                                      Icon="{ui:SymbolIcon ShieldDismiss24}"
                                    />
                                    <Separator />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.UnbanDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      FontWeight="SemiBold"
                                      Foreground="#00FF7F"
                                      Header="Lift Ban (Unban)"
                                      Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                    />
                                    <Separator />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.RevokeTrialCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Foreground="#FF453A"
                                      Header="Revoke Free Trial"
                                      Icon="{ui:SymbolIcon Dismiss24}"
                                      ToolTip="Immediately terminates the free trial for this hardware identifier."
                                    />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.ResetTrialCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Foreground="#38BDF8"
                                      Header="Reset Trial Tombstone (Allow New Trial)"
                                      Icon="{ui:SymbolIcon ArrowReset24}"
                                      ToolTip="Clears the trial claimed tombstone, allowing this device to claim a 3-day trial again."
                                    />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.ExtendTrialCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Foreground="#00FF7F"
                                      Header="Grant / Extend Trial (+3 Days)"
                                      Icon="{ui:SymbolIcon Sparkle24}"
                                      ToolTip="Activates or extends a 3-day free trial on this device immediately."
                                    />
                                    <Separator />
                                    <MenuItem
                                      Command="{Binding PlacementTarget.Tag.CopyHwidCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Header="Copy Full HWID"
                                      Icon="{ui:SymbolIcon Copy24}"
                                    />
                                  </ContextMenu>
                                </Button.ContextMenu>
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid
                      Height="80"
                      Visibility="{Binding AdminVM.IsDevicesLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                    >
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing Width="32" Height="32" IsIndeterminate="True" />
                        <ui:TextBlock
                          Margin="0,8,0,0"
                          FontSize="11"
                          Opacity="0.7"
                          Text="Syncing with Cloudflare Gatekeeper..."
                        />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </ui:Card>
              </StackPanel>
            </ScrollViewer>

            <Grid Visibility="{Binding AdminVM.IsLogsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="20">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                      <ui:SymbolIcon
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource SystemAccentColorBrush}"
                        Symbol="Settings24"
                      />
                      <ui:TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Admin Development Settings"
                      />
                    </StackPanel>
                    <ui:TextBlock
                      FontTypography="Caption"
                      Opacity="0.7"
                      Text="Configure runtime synchronization and developer options."
                    />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical">
                    <CheckBox
                      Content="Preserve Local Target URLs (Disable Remote Target Overwrite)"
                      FontSize="12"
                      FontWeight="SemiBold"
                      IsChecked="{Binding AdminVM.SkipRemoteTargetSync}"
                      ToolTip="When enabled, app startup will NOT overwrite your local DetailsTarget or ShotEffect targets with GitHub remote values."
                    />
                    <StackPanel
                      Margin="0,10,0,0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                    >
                      <CheckBox
                        Content="Force Halloween Theme (Preview Mode)"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FFFF7518"
                        IsChecked="{Binding AdminVM.ForceHalloweenPreview}"
                        ToolTip="Forces the Halloween pumpkin-orange theme and seasonal icon regardless of calendar date."
                      />
                      <CheckBox
                        Margin="16,0,0,0"
                        Content="Play Spooky Audio Effects"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FF9B51E0"
                        IsChecked="{Binding AdminVM.EnableHalloweenSound}"
                        ToolTip="Enables procedural atmospheric chimes on startup and hollow wooden clicks on UI buttons."
                      />
                      <ui:TextBlock
                        Margin="14,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.8"
                        Text="{Binding AdminVM.HalloweenStatusText}"
                        VerticalAlignment="Center"
                      />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </ui:Card>

              <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="20">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                      <ui:SymbolIcon
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource SystemAccentColorBrush}"
                        Symbol="DocumentBulletList24"
                      />
                      <ui:TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="System &amp; Diagnostic Logs"
                      />
                    </StackPanel>
                    <ui:TextBlock
                      FontTypography="Caption"
                      Opacity="0.7"
                      Text="Admin view of application diagnostics, hardware fingerprinting, and Cloudflare Gatekeeper events."
                    />
                  </StackPanel>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                      Margin="0,0,8,0"
                      Appearance="Secondary"
                      Command="{Binding AdminVM.CopyAdminLogsCommand}"
                      Content="Copy All"
                      Icon="{ui:SymbolIcon Copy24}"
                    />
                    <ui:Button
                      Margin="0,0,8,0"
                      Appearance="Secondary"
                      Command="{Binding AdminVM.OpenAdminLogsFolderCommand}"
                      Content="Open Folder"
                      Icon="{ui:SymbolIcon Folder24}"
                    />
                    <ui:Button
                      Margin="0,0,8,0"
                      Appearance="Secondary"
                      Command="{Binding AdminVM.ClearAdminLogsCommand}"
                      Content="Clear View"
                      Icon="{ui:SymbolIcon Delete24}"
                    />
                    <ui:Button
                      Appearance="Primary"
                      Command="{Binding AdminVM.RefreshAdminLogsCommand}"
                      Content="Refresh"
                      Icon="{ui:SymbolIcon ArrowSync24}"
                    />
                  </StackPanel>
                </Grid>
              </ui:Card>

              <ui:Card Grid.Row="2" Padding="14">
                <ScrollViewer
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                >
                  <TextBox
                    AcceptsReturn="True"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas, 'Cascadia Mono', 'Courier New', monospace"
                    FontSize="11.5"
                    Foreground="#D0D0D0"
                    IsReadOnly="True"
                    Text="{Binding AdminVM.AdminLogContent, Mode=OneWay}"
                    TextWrapping="NoWrap"
                  />
                </ScrollViewer>
              </ui:Card>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <Grid
      x:Name="DeviceProfileModalOverlay"
      Panel.ZIndex="3500"
      Background="#B3000000"
      Visibility="{Binding AdminVM.IsDeviceProfileVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
    >
      <Border
        Width="700"
        MaxHeight="680"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="14"
      >
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" Opacity="0.5" ShadowDepth="0" Color="Black" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
              <ui:SymbolIcon
                Margin="0,0,10,0"
                Filled="True"
                FontSize="24"
                Foreground="{DynamicResource SystemAccentColorBrush}"
                Symbol="PersonCircle24"
              />
              <StackPanel>
                <ui:TextBlock
                  FontSize="18"
                  FontWeight="Bold"
                  Foreground="White"
                  Text="User &amp; Device Profile"
                />
                <ui:TextBlock
                  FontTypography="Caption"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="Detailed hardware and licensing information"
                />
              </StackPanel>
            </StackPanel>

            <ui:Button
              Grid.Column="1"
              Padding="8,6"
              Appearance="Secondary"
              Command="{Binding AdminVM.CloseDeviceProfileCommand}"
              Icon="{ui:SymbolIcon Dismiss24}"
            />
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border
                Margin="0,0,0,14"
                Padding="14,12"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
              >
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <ui:TextBlock
                      FontTypography="Caption"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="DEVICE ACCESS STATUS"
                    />
                    <ui:TextBlock
                      Margin="0,4,0,0"
                      FontSize="15"
                      FontWeight="Bold"
                      Text="{Binding AdminVM.SelectedProfileDevice.StatusDisplay}"
                    />
                  </StackPanel>

                  <Border
                    Grid.Column="1"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                  >
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#2500FF7F" />
                        <Setter Property="BorderBrush" Value="#8000FF7F" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                          <DataTrigger
                            Binding="{Binding AdminVM.SelectedProfileDevice.IsBanned}"
                            Value="True"
                          >
                            <Setter Property="Background" Value="#25FF3B30" />
                            <Setter Property="BorderBrush" Value="#80FF3B30" />
                          </DataTrigger>
                          <DataTrigger
                            Binding="{Binding AdminVM.SelectedProfileDevice.IsTempBan}"
                            Value="True"
                          >
                            <Setter Property="Background" Value="#25FF9F0A" />
                            <Setter Property="BorderBrush" Value="#80FF9F0A" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <ui:TextBlock FontSize="11" FontWeight="Bold">
                      <ui:TextBlock.Style>
                        <Style TargetType="ui:TextBlock">
                          <Setter Property="Text" Value="AUTHORIZED" />
                          <Setter Property="Foreground" Value="#00FF7F" />
                          <Style.Triggers>
                            <DataTrigger
                              Binding="{Binding AdminVM.SelectedProfileDevice.IsBanned}"
                              Value="True"
                            >
                              <Setter Property="Text" Value="PERMANENTLY BANNED" />
                              <Setter Property="Foreground" Value="#FF453A" />
                            </DataTrigger>
                            <DataTrigger
                              Binding="{Binding AdminVM.SelectedProfileDevice.IsTempBan}"
                              Value="True"
                            >
                              <Setter Property="Text" Value="TEMPORARILY BANNED" />
                              <Setter Property="Foreground" Value="#FF9F0A" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ui:TextBlock.Style>
                    </ui:TextBlock>
                  </Border>
                </Grid>
              </Border>

              <ui:Card Margin="0,0,0,14" Padding="14">
                <StackPanel>
                  <ui:TextBlock
                    Margin="0,0,0,10"
                    FontTypography="Caption"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="HARDWARE IDENTIFIER &amp; NETWORK"
                  />

                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      FontTypography="Caption"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="Full HWID:"
                    />
                    <ui:TextBox
                      Grid.Column="1"
                      FontFamily="Consolas, monospace"
                      FontSize="11"
                      IsReadOnly="True"
                      Text="{Binding AdminVM.SelectedProfileDevice.Hwid, Mode=OneWay}"
                    />
                    <Button
                      Grid.Column="2"
                      Margin="6,0,0,0"
                      Command="{Binding AdminVM.CopyKeyCommand}"
                      CommandParameter="{Binding AdminVM.SelectedProfileDevice.Hwid}"
                      Style="{StaticResource RowIconButtonStyle}"
                      ToolTip="Copy Full HWID"
                    >
                      <ui:SymbolIcon FontSize="15" Symbol="Copy24" />
                    </Button>
                  </Grid>

                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      FontTypography="Caption"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="IP Address:"
                    />
                    <ui:TextBox
                      Grid.Column="1"
                      FontFamily="Consolas, monospace"
                      FontSize="11"
                      IsReadOnly="True"
                      Text="{Binding AdminVM.SelectedProfileDevice.IpAddress, Mode=OneWay}"
                    />
                    <Button
                      Grid.Column="2"
                      Margin="6,0,0,0"
                      Command="{Binding AdminVM.CopyKeyCommand}"
                      CommandParameter="{Binding AdminVM.SelectedProfileDevice.IpAddress}"
                      Style="{StaticResource RowIconButtonStyle}"
                      ToolTip="Copy IP"
                    >
                      <ui:SymbolIcon FontSize="15" Symbol="Copy24" />
                    </Button>
                  </Grid>

                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="First Connection:"
                      />
                      <ui:TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Text="{Binding AdminVM.SelectedProfileDevice.FirstSeen, TargetNullValue='Unknown'}"
                      />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <ui:TextBlock
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Last Seen:"
                      />
                      <ui:TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Text="{Binding AdminVM.SelectedProfileDevice.LastSeen, TargetNullValue='Unknown'}"
                      />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </ui:Card>

              <ui:Card Margin="0,0,0,14" Padding="14">
                <StackPanel>
                  <ui:TextBlock
                    Margin="0,0,0,10"
                    FontTypography="Caption"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="PREMIUM LICENSE ASSOCIATION"
                  />

                  <StackPanel Visibility="{Binding AdminVM.HasProfileKey, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="License Key:"
                      />
                      <ui:TextBox
                        Grid.Column="1"
                        FontFamily="Consolas, monospace"
                        FontSize="11"
                        FontWeight="Bold"
                        IsReadOnly="True"
                        Text="{Binding AdminVM.SelectedProfileKey.LicenseKey, Mode=OneWay}"
                      />
                      <Button
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Command="{Binding AdminVM.CopyKeyCommand}"
                        CommandParameter="{Binding AdminVM.SelectedProfileKey.LicenseKey}"
                        Style="{StaticResource RowIconButtonStyle}"
                        ToolTip="Copy Key"
                      >
                        <ui:SymbolIcon FontSize="15" Symbol="Copy24" />
                      </Button>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <ui:TextBlock
                          FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="Linked Nickname:"
                        />
                        <ui:TextBlock
                          Margin="0,2,0,0"
                          FontSize="13"
                          FontWeight="Bold"
                          Text="{Binding AdminVM.SelectedProfileKey.Nickname, TargetNullValue='None'}"
                        />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <ui:TextBlock
                          FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="License Status:"
                        />
                        <ui:TextBlock
                          Margin="0,2,0,0"
                          FontSize="13"
                          FontWeight="Bold"
                          Text="{Binding AdminVM.SelectedProfileKey.Status}"
                        >
                          <ui:TextBlock.Style>
                            <Style TargetType="ui:TextBlock">
                              <Setter Property="Foreground" Value="#38BDF8" />
                              <Style.Triggers>
                                <DataTrigger
                                  Binding="{Binding AdminVM.SelectedProfileKey.IsActive}"
                                  Value="True"
                                >
                                  <Setter Property="Foreground" Value="#00FF7F" />
                                </DataTrigger>
                                <DataTrigger
                                  Binding="{Binding AdminVM.SelectedProfileKey.IsRevoked}"
                                  Value="True"
                                >
                                  <Setter Property="Foreground" Value="#FF453A" />
                                </DataTrigger>
                                <DataTrigger
                                  Binding="{Binding AdminVM.SelectedProfileKey.IsExpired}"
                                  Value="True"
                                >
                                  <Setter Property="Foreground" Value="#FF9F0A" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ui:TextBlock.Style>
                        </ui:TextBlock>
                      </StackPanel>
                    </Grid>
                  </StackPanel>

                  <StackPanel Visibility="{Binding AdminVM.HasProfileKey, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ui:TextBlock
                      Margin="0,0,0,8"
                      FontSize="12"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="No active premium license is currently bound to this device."
                    />

                    <ui:Button
                      HorizontalAlignment="Left"
                      Appearance="Primary"
                      Command="{Binding AdminVM.ProfileAssignKeyCommand}"
                      Content="Assign a Key to this Device"
                      Icon="{ui:SymbolIcon Key24}"
                    />
                  </StackPanel>

                  <Separator
                    Margin="0,12,0,10"
                    Background="{DynamicResource CardStrokeColorDefaultBrush}"
                  />

                  <ui:TextBlock
                    Margin="0,0,0,8"
                    FontTypography="Caption"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="FREE TRIAL CONTROLS"
                  />
                  <StackPanel Orientation="Horizontal">
                    <ui:Button
                      Margin="0,0,8,0"
                      Appearance="Success"
                      Command="{Binding AdminVM.ExtendTrialCommand}"
                      CommandParameter="{Binding AdminVM.SelectedProfileDevice}"
                      Content="Grant / Extend Trial (+3 Days)"
                      Icon="{ui:SymbolIcon Sparkle24}"
                    />
                    <ui:Button
                      Margin="0,0,8,0"
                      Appearance="Secondary"
                      Command="{Binding AdminVM.ResetTrialCommand}"
                      CommandParameter="{Binding AdminVM.SelectedProfileDevice}"
                      Content="Reset Trial Tombstone"
                      Icon="{ui:SymbolIcon ArrowReset24}"
                    />
                    <ui:Button
                      Appearance="Danger"
                      Command="{Binding AdminVM.RevokeTrialCommand}"
                      CommandParameter="{Binding AdminVM.SelectedProfileDevice}"
                      Content="Revoke Trial"
                      Icon="{ui:SymbolIcon Dismiss24}"
                    />
                  </StackPanel>
                </StackPanel>
              </ui:Card>

              <Border
                Margin="0,0,0,8"
                Padding="12"
                Background="#1AFF453A"
                BorderBrush="#40FF453A"
                BorderThickness="1"
                CornerRadius="8"
              >
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger
                        Binding="{Binding AdminVM.SelectedProfileDevice.IsBanned}"
                        Value="True"
                      >
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger
                        Binding="{Binding AdminVM.SelectedProfileDevice.IsTempBan}"
                        Value="True"
                      >
                        <Setter Property="Background" Value="#1AFF9F0A" />
                        <Setter Property="BorderBrush" Value="#40FF9F0A" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <ui:TextBlock FontTypography="Caption" FontWeight="Bold">
                    <ui:TextBlock.Style>
                      <Style TargetType="ui:TextBlock">
                        <Setter Property="Foreground" Value="#FF453A" />
                        <Setter Property="Text" Value="PERMANENT BAN INFORMATION" />
                        <Style.Triggers>
                          <DataTrigger
                            Binding="{Binding AdminVM.SelectedProfileDevice.IsTempBan}"
                            Value="True"
                          >
                            <Setter Property="Foreground" Value="#FF9F0A" />
                            <Setter Property="Text" Value="TEMPORARY BAN DETAILS" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:TextBlock.Style>
                  </ui:TextBlock>
                  <ui:TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="White"
                    Text="{Binding AdminVM.SelectedProfileDevice.BanReason, StringFormat='Reason: {0}'}"
                  />
                  <ui:TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#FF9F0A"
                    Text="{Binding AdminVM.SelectedProfileDevice.FormattedBanExpires, StringFormat='Expires: {0}'}"
                  >
                    <ui:TextBlock.Style>
                      <Style TargetType="ui:TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger
                            Binding="{Binding AdminVM.SelectedProfileDevice.IsTempBan}"
                            Value="True"
                          >
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:TextBlock.Style>
                  </ui:TextBlock>
                </StackPanel>
              </Border>

              <StackPanel Margin="0,4,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                  Margin="0,0,8,0"
                  Appearance="Secondary"
                  Command="{Binding AdminVM.Ban1DayCommand}"
                  CommandParameter="{Binding AdminVM.SelectedProfileDevice}"
                  Content="Ban 24h"
                >
                  <ui:Button.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger
                          Binding="{Binding AdminVM.SelectedProfileDevice.IsBanned}"
                          Value="True"
                        >
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>

                <ui:Button
                  Margin="0,0,8,0"
                  Appearance="Secondary"
                  Command="{Binding AdminVM.Ban7DaysCommand}"
                  CommandParameter="{Binding AdminVM.SelectedProfileDevice}"
                  Content="Ban 7d"
                >
                  <ui:Button.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger
                          Binding="{Binding AdminVM.SelectedProfileDevice.IsBanned}"
                          Value="True"
                        >
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>

                <ui:Button
                  Margin="0,0,8,0"
                  Appearance="Danger"
                  Command="{Binding AdminVM.BanPermanentCommand}"
                  CommandParameter="{Binding AdminVM.SelectedProfileDevice}"
                  Content="{DynamicResource Loc_Admin_PermanentBan}"
                >
                  <ui:Button.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger
                          Binding="{Binding AdminVM.SelectedProfileDevice.IsBanned}"
                          Value="True"
                        >
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>

                <ui:Button
                  Appearance="Success"
                  Command="{Binding AdminVM.UnbanDeviceCommand}"
                  CommandParameter="{Binding AdminVM.SelectedProfileDevice}"
                  Content="{DynamicResource Loc_Admin_LiftBan}"
                >
                  <ui:Button.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger
                          Binding="{Binding AdminVM.SelectedProfileDevice.IsBanned}"
                          Value="True"
                        >
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:Button.Style>
                </ui:Button>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" Margin="0,8,0,0">
            <ui:Button
              HorizontalAlignment="Right"
              Appearance="Secondary"
              Command="{Binding AdminVM.CloseDeviceProfileCommand}"
              Content="{DynamicResource Loc_Admin_CloseProfile}"
            />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid
      x:Name="AssignKeyModalOverlay"
      Panel.ZIndex="3500"
      Background="#B3000000"
      Visibility="{Binding AdminVM.IsAssignKeyModalVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
    >
      <Border
        Width="620"
        MaxHeight="680"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="14"
      >
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" Opacity="0.5" ShadowDepth="0" Color="Black" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
              <ui:SymbolIcon
                Margin="0,0,10,0"
                Filled="True"
                FontSize="24"
                Foreground="{DynamicResource SystemAccentColorBrush}"
                Symbol="PersonKey24"
              />
              <StackPanel>
                <ui:TextBlock
                  FontSize="18"
                  FontWeight="Bold"
                  Foreground="White"
                  Text="{DynamicResource Loc_Admin_AssignLicenseKey}"
                />
                <ui:TextBlock
                  FontTypography="Caption"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{DynamicResource Loc_Admin_AssignLicenseKeyDesc}"
                />
              </StackPanel>
            </StackPanel>

            <ui:Button
              Grid.Column="1"
              Padding="8,6"
              Appearance="Secondary"
              Command="{Binding AdminVM.CloseAssignKeyModalCommand}"
              Icon="{ui:SymbolIcon Dismiss24}"
            />
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,0,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border
                Margin="0,0,0,14"
                Padding="14,10"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
              >
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <ui:TextBlock
                      FontTypography="Caption"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{DynamicResource Loc_Admin_TargetLicenseKey}"
                    />
                    <ui:TextBlock
                      Margin="0,2,0,0"
                      FontFamily="Consolas, monospace"
                      FontSize="14"
                      FontWeight="Bold"
                      Foreground="White"
                      Text="{Binding AdminVM.TargetAssignKeyItem.LicenseKey}"
                    />
                  </StackPanel>
                  <Border
                    Grid.Column="1"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="#1A00FF7F"
                    BorderBrush="#00FF7F"
                    BorderThickness="1"
                    CornerRadius="4"
                  >
                    <ui:TextBlock
                      FontSize="11"
                      FontWeight="Bold"
                      Foreground="#00FF7F"
                      Text="{Binding AdminVM.TargetAssignKeyItem.Status}"
                    />
                  </Border>
                </Grid>
              </Border>

              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <ui:TextBlock
                    Margin="0,0,0,4"
                    FontTypography="Caption"
                    FontWeight="SemiBold"
                    Text="{DynamicResource Loc_Admin_AssignToNickname}"
                  />
                  <ui:TextBox
                    PlaceholderText="{DynamicResource Loc_Admin_AssignNicknamePlaceholder}"
                    Text="{Binding AdminVM.AssignNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                  <ui:Button
                    Appearance="Secondary"
                    Command="{Binding AdminVM.SelectMyDeviceForAssignCommand}"
                    Content="{DynamicResource Loc_Admin_SelectThisPc}"
                    Icon="{ui:SymbolIcon Desktop24}"
                    ToolTip="{DynamicResource Loc_Admin_SelectThisPcTooltip}"
                  />
                </StackPanel>
              </Grid>

              <ui:TextBlock
                Margin="0,0,0,6"
                FontTypography="Caption"
                FontWeight="SemiBold"
                Text="{DynamicResource Loc_Admin_SelectTargetDevice}"
              />

              <ui:TextBox
                Margin="0,0,0,8"
                ClearButtonEnabled="True"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{DynamicResource Loc_Admin_SearchUsersPlaceholder}"
                Text="{Binding AdminVM.AssignSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              />

              <ListView
                Height="200"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding AdminVM.FilteredAssignDevices}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding AdminVM.SelectedAssignDevice, Mode=TwoWay}"
              >
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                          <Border
                            x:Name="ItemBorder"
                            Padding="12,8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                          >
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter
                                TargetName="ItemBorder"
                                Property="BorderBrush"
                                Value="{DynamicResource SystemAccentColorBrush}"
                              />
                              <Setter
                                TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource ControlFillColorSecondaryBrush}"
                              />
                              <Setter
                                TargetName="ItemBorder"
                                Property="BorderThickness"
                                Value="2"
                              />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter
                                TargetName="ItemBorder"
                                Property="Background"
                                Value="{DynamicResource ControlFillColorTertiaryBrush}"
                              />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="110" />
                      </Grid.ColumnDefinitions>

                      <RadioButton
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                        IsHitTestVisible="False"
                      />

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock
                          FontFamily="Consolas, monospace"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="{Binding ShortHwid}"
                          ToolTip="{Binding Hwid}"
                        />
                        <ui:TextBlock
                          FontTypography="Caption"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding LastSeen, StringFormat='Last seen: {0}'}"
                        />
                      </StackPanel>

                      <ui:TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, monospace"
                        FontSize="11"
                        Opacity="0.8"
                        Text="{Binding IpAddress}"
                      />

                      <ui:TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Text="{Binding StatusDisplay}"
                      >
                        <ui:TextBlock.Style>
                          <Style TargetType="ui:TextBlock">
                            <Setter Property="Foreground" Value="#00FF7F" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsBanned}" Value="True">
                                <Setter Property="Foreground" Value="#FF453A" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ui:TextBlock.Style>
                      </ui:TextBlock>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>

              <Border
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="6"
              >
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <ui:TextBlock
                      FontTypography="Caption"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{DynamicResource Loc_Admin_SelectedDevice}"
                    />
                    <ui:TextBlock
                      Margin="0,2,0,0"
                      FontSize="12"
                      FontWeight="SemiBold"
                      Text="{Binding AdminVM.SelectedAssignDevice.Hwid, TargetNullValue='(Please select a device from the list above)'}"
                      TextTrimming="CharacterEllipsis"
                    />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button
              Grid.Column="0"
              HorizontalAlignment="Left"
              Appearance="Secondary"
              Command="{Binding AdminVM.CloseAssignKeyModalCommand}"
              Content="{DynamicResource Loc_Admin_Cancel}"
            />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:ProgressRing
                Width="20"
                Height="20"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding AdminVM.IsAssigningKey, Converter={StaticResource BooleanToVisibilityConverter}}"
              />
              <ui:Button
                Appearance="Primary"
                Command="{Binding AdminVM.ConfirmAssignKeyCommand}"
                Content="{DynamicResource Loc_Admin_AssignAndActivateKey}"
                FontWeight="Bold"
                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                IsEnabled="{Binding AdminVM.CanConfirmAssignKey}"
              />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

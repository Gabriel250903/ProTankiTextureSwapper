<UserControl
  x:Class="TextureSwapper.Views.Controls.BackupsTabContent"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:TextureSwapper.Helpers.Converters"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:TextureSwapper.ViewModels"
  d:DataContext="{d:DesignInstance vm:MainViewModel,
                                     IsDesignTimeCreatable=False}"
  mc:Ignorable="d"
>
  <Grid Margin="0,10,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,15">
      <ui:TextBlock
        FontSize="32"
        FontTypography="Title"
        FontWeight="Bold"
        Text="{DynamicResource Loc_Backups_Title}"
        FontFamily="{DynamicResource ActiveDisplayFont}"
      />
      <ui:TextBlock Opacity="0.6" Text="{DynamicResource Loc_Backups_Desc}" />
    </StackPanel>

    <Border
      Grid.Row="2"
      Background="{DynamicResource ControlFillColorTertiaryBrush}"
      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      CornerRadius="12"
    >
      <ui:ListView ItemsSource="{Binding SnapshotBackups}" SelectedItem="{Binding SelectedBackup}">
        <ui:ListView.ItemTemplate>
          <DataTemplate>
            <Grid Margin="5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <ui:TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                <ui:TextBlock
                  FontSize="12"
                  Opacity="0.6"
                  Text="{Binding CreationDate, StringFormat='Created: {0:g}'}"
                />
              </StackPanel>
              <ui:Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Appearance="Primary"
                Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Content="{DynamicResource Loc_Backups_RestoreSnapshot}"
                Icon="{ui:SymbolIcon ArrowUndo24}"
              />
            </Grid>
          </DataTemplate>
        </ui:ListView.ItemTemplate>
      </ui:ListView>
    </Border>

    <Grid Grid.Row="3" Margin="0,15,0,0">
      <ui:InfoBar
        Title="{DynamicResource Loc_Backups_RetentionTitle}"
        IsClosable="False"
        IsOpen="True"
        Message="{DynamicResource Loc_Backups_RetentionMessage}"
        Severity="Informational"
      />
    </Grid>
  </Grid>
</UserControl>

<UserControl
  x:Class="TextureSwapper.Views.Controls.TwinsShotEditorView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:TextureSwapper.Views.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewmodels="clr-namespace:TextureSwapper.ViewModels.Tabs"
  d:DataContext="{d:DesignInstance Type=viewmodels:TwinsShotViewModel}"
  d:DesignHeight="600"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="350" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <TextBlock
          Margin="0,0,0,20"
          FontSize="20"
          FontWeight="Bold"
          Text="{DynamicResource Loc_ShotEffects_TwinsTitle}"
        />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
          <TextBlock Text="{DynamicResource Loc_ShotEffects_Hue}" />
          <TextBlock Text=": " />
          <TextBlock Text="{Binding Hue, StringFormat={}{0:F0}°}" FontWeight="SemiBold" />
        </StackPanel>
        <Border Height="6" Margin="2,0,2,4" CornerRadius="3">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
              <GradientStop Color="#FF0000" Offset="0.0" />
              <GradientStop Color="#FFFF00" Offset="0.167" />
              <GradientStop Color="#00FF00" Offset="0.333" />
              <GradientStop Color="#00FFFF" Offset="0.5" />
              <GradientStop Color="#0000FF" Offset="0.667" />
              <GradientStop Color="#FF00FF" Offset="0.833" />
              <GradientStop Color="#FF0000" Offset="1.0" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Slider
          Margin="0,0,0,15"
          IsSnapToTickEnabled="True"
          Maximum="360"
          Minimum="0"
          TickFrequency="1"
          Value="{Binding Hue}"
        />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
          <TextBlock Text="{DynamicResource Loc_ShotEffects_Saturation}" />
          <TextBlock Text=": " />
          <TextBlock Text="{Binding Saturation, StringFormat={}{0:F0}%}" FontWeight="SemiBold" />
        </StackPanel>
        <Slider
          Margin="0,0,0,15"
          IsSnapToTickEnabled="True"
          Maximum="200"
          Minimum="0"
          TickFrequency="1"
          Value="{Binding Saturation}"
        />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
          <TextBlock Text="{DynamicResource Loc_ShotEffects_Brightness}" />
          <TextBlock Text=": " />
          <TextBlock Text="{Binding Brightness, StringFormat={}{0:F0}%}" FontWeight="SemiBold" />
        </StackPanel>
        <Slider
          Margin="0,0,0,15"
          IsSnapToTickEnabled="True"
          Maximum="100"
          Minimum="-100"
          TickFrequency="1"
          Value="{Binding Brightness}"
        />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
          <TextBlock Text="{DynamicResource Loc_ShotEffects_Contrast}" />
          <TextBlock Text=": " />
          <TextBlock Text="{Binding Contrast, StringFormat={}{0:F2}}" FontWeight="SemiBold" />
        </StackPanel>
        <Slider
          Margin="0,0,0,15"
          IsSnapToTickEnabled="True"
          Maximum="3"
          Minimum="0"
          TickFrequency="0.1"
          Value="{Binding Contrast}"
        />

        <CheckBox
          Margin="0,0,0,20"
          Content="{DynamicResource Loc_ShotEffects_InvertColors}"
          IsChecked="{Binding Invert}"
        />

        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Stretch" Orientation="Horizontal">
          <Button
            Width="150"
            Padding="15,8"
            Background="#4CAF50"
            Command="{Binding SaveCommand}"
            Content="{DynamicResource Loc_ShotEffects_ApplyToGame}"
            FontWeight="Bold"
            Foreground="White"
          />
          <Button
            Width="150"
            Margin="10,0,0,0"
            Padding="15,8"
            Command="{Binding RestoreCommand}"
            Content="{DynamicResource Loc_ShotEffects_RestoreOriginal}"
          />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="2" Padding="20" Background="#1E1E1E" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
          Grid.Row="0"
          Margin="0,0,0,15"
          FontSize="16"
          FontWeight="SemiBold"
          Foreground="White"
          Text="{DynamicResource Loc_ShotEffects_LivePreview}"
        />

        <Border Grid.Row="1" Background="#2D2D30" ClipToBounds="True" CornerRadius="4">
          <Image
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="{Binding PreviewImage}"
            Stretch="Uniform"
          />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>

<UserControl
  x:Class="TextureSwapper.Views.Controls.IsidaShotEditorView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:TextureSwapper.Views.Controls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:viewmodels="clr-namespace:TextureSwapper.ViewModels.Tabs"
  d:DataContext="{d:DesignInstance Type=viewmodels:IsidaShotViewModel}"
  d:DesignHeight="650"
  d:DesignWidth="850"
  mc:Ignorable="d"
>
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="370" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <TextBlock
          Margin="0,0,0,15"
          FontSize="20"
          FontWeight="Bold"
          Text="{DynamicResource Loc_ShotEffects_IsidaTitle}"
        />

        <TabControl Margin="0,0,0,15" SelectedIndex="{Binding SelectedTabIndex}">
          <TabItem Header="{DynamicResource Loc_ShotEffects_DamageBeamTitle}">
            <StackPanel Margin="0,15,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource Loc_ShotEffects_Hue}" />
                <TextBlock Text=": " />
                <TextBlock
                  Text="{Binding DamageHue, StringFormat={}{0:F0}°}"
                  FontWeight="SemiBold"
                />
              </StackPanel>
              <Border Height="6" Margin="2,0,2,4" CornerRadius="3">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#FF0000" Offset="0.0" />
                    <GradientStop Color="#FFFF00" Offset="0.167" />
                    <GradientStop Color="#00FF00" Offset="0.333" />
                    <GradientStop Color="#00FFFF" Offset="0.5" />
                    <GradientStop Color="#0000FF" Offset="0.667" />
                    <GradientStop Color="#FF00FF" Offset="0.833" />
                    <GradientStop Color="#FF0000" Offset="1.0" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Slider
                Margin="0,0,0,15"
                IsSnapToTickEnabled="True"
                Maximum="360"
                Minimum="0"
                TickFrequency="1"
                Value="{Binding DamageHue}"
              />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource Loc_ShotEffects_Saturation}" />
                <TextBlock Text=": " />
                <TextBlock
                  Text="{Binding DamageSaturation, StringFormat={}{0:F0}%}"
                  FontWeight="SemiBold"
                />
              </StackPanel>
              <Slider
                Margin="0,0,0,15"
                IsSnapToTickEnabled="True"
                Maximum="200"
                Minimum="0"
                TickFrequency="1"
                Value="{Binding DamageSaturation}"
              />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource Loc_ShotEffects_Brightness}" />
                <TextBlock Text=": " />
                <TextBlock
                  Text="{Binding DamageBrightness, StringFormat={}{0:F0}%}"
                  FontWeight="SemiBold"
                />
              </StackPanel>
              <Slider
                Margin="0,0,0,15"
                IsSnapToTickEnabled="True"
                Maximum="100"
                Minimum="-100"
                TickFrequency="1"
                Value="{Binding DamageBrightness}"
              />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="{DynamicResource Loc_ShotEffects_Contrast}" />
                <TextBlock Text=": " />
                <TextBlock
                  Text="{Binding DamageContrast, StringFormat={}{0:F2}}"
                  FontWeight="SemiBold"
                />
              </StackPanel>
              <Slider
                Margin="0,0,0,15"
                IsSnapToTickEnabled="True"
                Maximum="3"
                Minimum="0"
                TickFrequency="0.1"
                Value="{Binding DamageContrast}"
              />

              <CheckBox
                Margin="0,0,0,10"
                Content="{DynamicResource Loc_ShotEffects_InvertColors}"
                IsChecked="{Binding DamageInvert}"
              />
            </StackPanel>
          </TabItem>

          <TabItem Header="{DynamicResource Loc_ShotEffects_HealingBeamTitle}">
            <StackPanel Margin="0,15,0,0">
              <CheckBox
                Margin="0,0,0,15"
                Content="{DynamicResource Loc_ShotEffects_SyncBall}"
                IsChecked="{Binding SyncHealWithDamage}"
              />

              <StackPanel IsEnabled="{Binding CanEditHeal}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                  <TextBlock Text="{DynamicResource Loc_ShotEffects_Hue}" />
                  <TextBlock Text=": " />
                  <TextBlock
                    Text="{Binding HealHue, StringFormat={}{0:F0}°}"
                    FontWeight="SemiBold"
                  />
                </StackPanel>
                <Border Height="6" Margin="2,0,2,4" CornerRadius="3">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                      <GradientStop Color="#FF0000" Offset="0.0" />
                      <GradientStop Color="#FFFF00" Offset="0.167" />
                      <GradientStop Color="#00FF00" Offset="0.333" />
                      <GradientStop Color="#00FFFF" Offset="0.5" />
                      <GradientStop Color="#0000FF" Offset="0.667" />
                      <GradientStop Color="#FF00FF" Offset="0.833" />
                      <GradientStop Color="#FF0000" Offset="1.0" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Slider
                  Margin="0,0,0,15"
                  IsSnapToTickEnabled="True"
                  Maximum="360"
                  Minimum="0"
                  TickFrequency="1"
                  Value="{Binding HealHue}"
                />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                  <TextBlock Text="{DynamicResource Loc_ShotEffects_Saturation}" />
                  <TextBlock Text=": " />
                  <TextBlock
                    Text="{Binding HealSaturation, StringFormat={}{0:F0}%}"
                    FontWeight="SemiBold"
                  />
                </StackPanel>
                <Slider
                  Margin="0,0,0,15"
                  IsSnapToTickEnabled="True"
                  Maximum="200"
                  Minimum="0"
                  TickFrequency="1"
                  Value="{Binding HealSaturation}"
                />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                  <TextBlock Text="{DynamicResource Loc_ShotEffects_Brightness}" />
                  <TextBlock Text=": " />
                  <TextBlock
                    Text="{Binding HealBrightness, StringFormat={}{0:F0}%}"
                    FontWeight="SemiBold"
                  />
                </StackPanel>
                <Slider
                  Margin="0,0,0,15"
                  IsSnapToTickEnabled="True"
                  Maximum="100"
                  Minimum="-100"
                  TickFrequency="1"
                  Value="{Binding HealBrightness}"
                />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                  <TextBlock Text="{DynamicResource Loc_ShotEffects_Contrast}" />
                  <TextBlock Text=": " />
                  <TextBlock
                    Text="{Binding HealContrast, StringFormat={}{0:F2}}"
                    FontWeight="SemiBold"
                  />
                </StackPanel>
                <Slider
                  Margin="0,0,0,15"
                  IsSnapToTickEnabled="True"
                  Maximum="3"
                  Minimum="0"
                  TickFrequency="0.1"
                  Value="{Binding HealContrast}"
                />

                <CheckBox
                  Margin="0,0,0,10"
                  Content="{DynamicResource Loc_ShotEffects_InvertColors}"
                  IsChecked="{Binding HealInvert}"
                />
              </StackPanel>
            </StackPanel>
          </TabItem>
        </TabControl>

        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Stretch" Orientation="Horizontal">
          <Button
            Width="150"
            Padding="15,8"
            Background="#4CAF50"
            Command="{Binding SaveCommand}"
            Content="{DynamicResource Loc_ShotEffects_ApplyToGame}"
            FontWeight="Bold"
            Foreground="White"
          />
          <Button
            Width="150"
            Margin="10,0,0,0"
            Padding="15,8"
            Command="{Binding RestoreCommand}"
            Content="{DynamicResource Loc_ShotEffects_RestoreOriginal}"
          />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="2" Padding="20" Background="#1E1E1E" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,15">
          <TextBlock
            VerticalAlignment="Center"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="White"
            Text="{DynamicResource Loc_ShotEffects_LivePreview}"
          />
          <ComboBox
            HorizontalAlignment="Right"
            Width="180"
            ItemsSource="{Binding ComponentOptions}"
            SelectedItem="{Binding SelectedComponentOption}"
          />
        </DockPanel>

        <Border Grid.Row="1" Background="#2D2D30" ClipToBounds="True" CornerRadius="4">
          <Image
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Source="{Binding PreviewImage}"
            Stretch="Uniform"
          />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>

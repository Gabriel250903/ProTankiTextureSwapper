<UserControl
  x:Class="TextureSwapper.Views.Controls.DeviceBannedOverlayControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  x:Name="RootControl"
  d:DesignHeight="700"
  d:DesignWidth="1200"
  mc:Ignorable="d"
>
  <Grid Panel.ZIndex="99999" Focusable="True" IsHitTestVisible="True">
    <Border Background="#F208080C">
      <Border.Effect>
        <BlurEffect Radius="25" />
      </Border.Effect>
    </Border>

    <Border
      Width="580"
      Padding="40,35"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
      BorderThickness="1.5"
      CornerRadius="20"
    >
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="#FF3333" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDeviceTempBanned}" Value="True">
              <Setter Property="BorderBrush" Value="#FF9F0A" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.Effect>
        <DropShadowEffect BlurRadius="40" Opacity="0.35" ShadowDepth="0" Color="#FF2222" />
      </Border.Effect>

      <StackPanel HorizontalAlignment="Center">
        <Border
          Width="76"
          Height="76"
          Margin="0,0,0,18"
          HorizontalAlignment="Center"
          CornerRadius="38"
        >
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#FF3B30" />
                    <GradientStop Offset="1" Color="#8B0000" />
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceTempBanned}" Value="True">
                  <Setter Property="Background">
                    <Setter.Value>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FFA500" />
                        <GradientStop Offset="1" Color="#C05621" />
                      </LinearGradientBrush>
                    </Setter.Value>
                  </Setter>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Filled="True"
            FontSize="38"
            Foreground="White"
          >
            <ui:SymbolIcon.Style>
              <Style TargetType="ui:SymbolIcon">
                <Setter Property="Symbol" Value="ShieldDismiss24" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDeviceTempBanned}" Value="True">
                    <Setter Property="Symbol" Value="Clock24" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:SymbolIcon.Style>
          </ui:SymbolIcon>
        </Border>

        <Border
          Margin="0,0,0,12"
          Padding="14,4"
          HorizontalAlignment="Center"
          BorderThickness="1"
          CornerRadius="12"
        >
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#2BFF3B30" />
              <Setter Property="BorderBrush" Value="#80FF3B30" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceTempBanned}" Value="True">
                  <Setter Property="Background" Value="#2BFF9F0A" />
                  <Setter Property="BorderBrush" Value="#80FF9F0A" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <ui:TextBlock FontSize="11" FontWeight="Bold" Text="{Binding DeviceBanTagText}">
            <ui:TextBlock.Style>
              <Style TargetType="ui:TextBlock">
                <Setter Property="Foreground" Value="#FF453A" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDeviceTempBanned}" Value="True">
                    <Setter Property="Foreground" Value="#FF9F0A" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:TextBlock.Style>
          </ui:TextBlock>
        </Border>

        <ui:TextBlock
          Margin="0,0,0,8"
          HorizontalAlignment="Center"
          FontSize="22"
          FontWeight="Bold"
          Text="{Binding DeviceBanHeading}"
          TextAlignment="Center"
        />

        <Border
          Margin="0,0,0,14"
          Padding="14,10"
          Background="#1AFF9F0A"
          BorderBrush="#60FF9F0A"
          BorderThickness="1"
          CornerRadius="8"
        >
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeviceTempBanned}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon
              Grid.Column="0"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Filled="True"
              FontSize="22"
              Foreground="#FF9F0A"
              Symbol="Clock24"
            />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <ui:TextBlock
                FontSize="10.5"
                FontWeight="Bold"
                Foreground="#FF9F0A"
                Text="{DynamicResource Loc_Ban_Duration}"
              />
              <ui:TextBlock
                Margin="0,2,0,0"
                FontSize="12.5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding DeviceBanExpiryDisplay}"
              />
            </StackPanel>
          </Grid>
        </Border>

        <Border
          Margin="0,0,0,24"
          Padding="12,8"
          Background="#0AFFFFFF"
          BorderBrush="#15FFFFFF"
          BorderThickness="1"
          CornerRadius="8"
        >
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <ui:TextBlock
                Margin="0,0,0,10"
                FontSize="14"
                Opacity="0.5"
                Text="{DynamicResource Loc_Ban_Reason}"
              />
              <ui:TextBlock
                FontFamily="Consolas, monospace"
                FontSize="12"
                Opacity="0.8"
                Text="{Binding DeviceBanReason}"
                TextTrimming="CharacterEllipsis"
              />
            </StackPanel>
          </Grid>
        </Border>

        <Border
          Margin="0,0,0,24"
          Padding="12,8"
          Background="#0AFFFFFF"
          BorderBrush="#15FFFFFF"
          BorderThickness="1"
          CornerRadius="8"
        >
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ui:TextBlock
                  Margin="0,0,0,10"
                  FontSize="14"
                  Opacity="0.5"
                  Text="{DynamicResource Loc_Ban_Hwid}"
                />
                <ui:TextBlock
                  x:Name="HwidMaskedText"
                  FontFamily="Consolas, monospace"
                  FontSize="11"
                  Opacity="0.7"
                  Text="••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••"
                />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:Button
                  x:Name="ToggleHwidButton"
                  Margin="10,0,0,-10"
                  Padding="10,6"
                  Appearance="Secondary"
                  Click="OnToggleHwidClicked"
                  Content="{DynamicResource Loc_Ban_Reveal}"
                  FontSize="11"
                  Icon="{ui:SymbolIcon Eye24}"
                />
                <ui:Button
                  Margin="10,0,0,-10"
                  Padding="10,6"
                  Appearance="Secondary"
                  Click="OnCopyHwidClicked"
                  Content="{DynamicResource Loc_Ban_Copy}"
                  FontSize="11"
                  Icon="{ui:SymbolIcon Copy24}"
                />
              </StackPanel>
            </Grid>

            <Border
              x:Name="RevealedHwidBorder"
              Margin="0,8,0,0"
              Padding="8,6"
              Background="#10FFFFFF"
              BorderBrush="#20FFFFFF"
              BorderThickness="1"
              CornerRadius="6"
              Visibility="Collapsed"
            >
              <ui:TextBlock
                FontFamily="Consolas, monospace"
                FontSize="11"
                Foreground="#00E5FF"
                Opacity="0.95"
                Text="{Binding DeviceHwidDisplay}"
                TextWrapping="Wrap"
              />
            </Border>
          </StackPanel>
        </Border>

        <ui:Button
          MinWidth="220"
          Padding="24,12"
          HorizontalAlignment="Center"
          Appearance="Danger"
          Click="OnExitClicked"
          Content="{DynamicResource Loc_Ban_Exit}"
          FontSize="14"
          FontWeight="Bold"
          Icon="{ui:SymbolIcon Dismiss24}"
        />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

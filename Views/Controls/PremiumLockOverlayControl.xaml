<UserControl
  x:Class="TextureSwapper.Views.Controls.PremiumLockOverlayControl"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  x:Name="RootControl"
  d:DesignHeight="400"
  d:DesignWidth="600"
  mc:Ignorable="d"
>
  <Grid
    Panel.ZIndex="999"
    Visibility="{Binding IsLocked, ElementName=RootControl, Converter={StaticResource BooleanToVisibilityConverter}}"
  >
    <Border Background="#F00F0F14" CornerRadius="16">
      <Border.Effect>
        <BlurEffect Radius="20" />
      </Border.Effect>
    </Border>

    <Border
      Width="520"
      Padding="35,30"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="{DynamicResource ControlFillColorDefaultBrush}"
      BorderBrush="#FFD700"
      BorderThickness="1.5"
      CornerRadius="20"
    >
      <Border.Effect>
        <DropShadowEffect BlurRadius="35" Opacity="0.3" ShadowDepth="0" Color="#FFD700" />
      </Border.Effect>

      <StackPanel HorizontalAlignment="Center">
        <Border
          Width="72"
          Height="72"
          Margin="0,0,0,15"
          HorizontalAlignment="Center"
          CornerRadius="36"
        >
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Offset="0" Color="#FFD700" />
              <GradientStop Offset="1" Color="#FF8C00" />
            </LinearGradientBrush>
          </Border.Background>
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Filled="True"
            FontSize="36"
            Foreground="#121212"
            Symbol="LockClosed24"
          />
        </Border>

        <Border
          Margin="0,0,0,12"
          Padding="14,4"
          HorizontalAlignment="Center"
          Background="#26FFD700"
          BorderBrush="#80FFD700"
          BorderThickness="1"
          CornerRadius="12"
        >
          <ui:TextBlock
            FontSize="11"
            FontWeight="Bold"
            Foreground="#FFD700"
            Text="{DynamicResource Loc_Premium_FeatureBadge}"
          />
        </Border>

        <ui:TextBlock
          Margin="0,0,0,8"
          HorizontalAlignment="Center"
          FontSize="22"
          FontWeight="Bold"
          Text="{Binding FeatureTitle, ElementName=RootControl}"
          TextAlignment="Center"
        />

        <StackPanel Margin="0,4,0,12" HorizontalAlignment="Center">
          <ui:Button
            x:Name="StartTrialButton"
            Margin="0,0,0,8"
            Padding="24,10"
            HorizontalAlignment="Center"
            Appearance="Success"
            Click="OnStartTrialClicked"
            Command="{Binding StartTrialCommand, ElementName=RootControl}"
            Content="{DynamicResource Loc_Premium_StartTrial}"
            FontSize="14"
            FontWeight="Bold"
            Icon="{ui:SymbolIcon Sparkle24}"
            Visibility="{Binding CanStartTrial, ElementName=RootControl, Converter={StaticResource BooleanToVisibilityConverter}}"
          />
          <ui:TextBlock
            HorizontalAlignment="Center"
            FontTypography="Caption"
            Foreground="#FFAAAAAA"
            Text="{DynamicResource Loc_Premium_TrialExpired}"
            Visibility="{Binding HasClaimedTrial, ElementName=RootControl, Converter={StaticResource BooleanToVisibilityConverter}}"
          />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
          <ui:Button
            Margin="0,0,10,0"
            Padding="20,10"
            Appearance="Primary"
            Click="OnBuyClicked"
            Command="{Binding BuyCommand, ElementName=RootControl}"
            Content="{DynamicResource Loc_Premium_GetKey}"
            FontSize="14"
            FontWeight="Bold"
            Icon="{ui:SymbolIcon Open24}"
          />
          <ui:Button
            Padding="20,10"
            Appearance="Secondary"
            Click="OnEnterKeyClicked"
            Command="{Binding EnterKeyCommand, ElementName=RootControl}"
            Content="{DynamicResource Loc_Premium_EnterKey}"
            FontSize="14"
            FontWeight="SemiBold"
            Icon="{ui:SymbolIcon Key24}"
          />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

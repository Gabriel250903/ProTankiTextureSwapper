<ui:FluentWindow
    x:Class="TextureSwapper.Views.Windows.GoldBoxTargetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Loc_GoldBoxTarget_Title}"
    Width="480"
    Height="290"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <ui:TextBlock
                FontSize="17"
                FontWeight="SemiBold"
                Text="{DynamicResource Loc_GoldBoxTarget_Title}" />
            <ui:TextBlock
                Margin="0,6,0,0"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{DynamicResource Loc_GoldBoxTarget_Prompt}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <RadioButton
                x:Name="NormalRadioButton"
                Margin="0,0,0,10"
                Content="{DynamicResource Loc_GoldBoxTarget_Normal}"
                FontSize="14" />
            <RadioButton
                x:Name="PumpkinRadioButton"
                Margin="0,0,0,10"
                Content="{DynamicResource Loc_GoldBoxTarget_Pumpkin}"
                FontSize="14" />
            <RadioButton
                x:Name="BothRadioButton"
                Margin="0,0,0,10"
                Content="{DynamicResource Loc_GoldBoxTarget_Both}"
                FontSize="14"
                IsChecked="True" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                Margin="0,0,10,0"
                Appearance="Secondary"
                Click="CancelButton_Click"
                Content="{DynamicResource Loc_Dialog_Cancel}" />
            <ui:Button
                Appearance="Primary"
                Click="ApplyButton_Click"
                Content="{DynamicResource Loc_Dialog_Apply}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>

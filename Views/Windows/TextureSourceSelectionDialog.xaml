<ui:FluentWindow
  x:Class="TextureSwapper.Views.Windows.TextureSourceSelectionDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Textures Download"
  Width="520"
  Height="370"
  Background="{DynamicResource ApplicationBackgroundBrush}"
  ExtendsContentIntoTitleBar="True"
  ResizeMode="NoResize"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterScreen"
>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon
          Margin="0,0,10,0"
          FontSize="22"
          Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
          Symbol="ArrowDownload24"
        />
        <ui:TextBlock FontSize="18" FontWeight="SemiBold" Text="Textures Download Required" />
      </StackPanel>
      <ui:TextBlock
        Margin="0,8,0,0"
        FontSize="13"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="TextureSwapper requires all the textures to preview and swap skins (~600 MB). Choose your preferred download source:"
        TextWrapping="Wrap"
      />
    </StackPanel>

    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <ui:CardAction
        x:Name="CloudflareCard"
        Margin="0,0,0,12"
        Padding="14,12"
        Click="CloudflareCard_Click"
      >
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <RadioButton
            x:Name="CloudflareRadio"
            Grid.Column="0"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            IsChecked="True"
          />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <ui:TextBlock FontWeight="SemiBold" Text="Cloudflare CDN" />
              <Border
                Margin="8,0,0,0"
                Padding="6,1"
                Background="#262ECC71"
                BorderBrush="#802ECC71"
                BorderThickness="1"
                CornerRadius="8"
              >
                <ui:TextBlock
                  FontSize="10"
                  FontWeight="Bold"
                  Foreground="#2ECC71"
                  Text="RECOMMENDED"
                />
              </Border>
            </StackPanel>
            <ui:TextBlock
              Margin="0,2,0,0"
              FontTypography="Caption"
              Opacity="0.65"
              Text="Global distribution. No rate limits."
            />
          </StackPanel>
        </Grid>
      </ui:CardAction>

      <ui:CardAction x:Name="GitHubCard" Padding="14,12" Click="GitHubCard_Click">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <RadioButton
            x:Name="GitHubRadio"
            Grid.Column="0"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
          />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:TextBlock FontWeight="SemiBold" Text="GitHub Releases" />
            <ui:TextBlock
              Margin="0,2,0,0"
              FontTypography="Caption"
              Opacity="0.65"
              Text="Direct repository download. May be rate limited."
            />
          </StackPanel>
        </Grid>
      </ui:CardAction>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <ui:Button
        Margin="0,0,10,0"
        Appearance="Secondary"
        Click="CancelButton_Click"
        Content="Skip (Offline Mode)"
      />
      <ui:Button
        Appearance="Secondary"
        Click="StartDownloadButton_Click"
        Content="Start Download"
        Icon="{ui:SymbolIcon ArrowDownload24}"
      />
    </StackPanel>
  </Grid>
</ui:FluentWindow>

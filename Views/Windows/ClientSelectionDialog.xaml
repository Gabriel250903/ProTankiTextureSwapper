<ui:FluentWindow
    x:Class="TextureSwapper.Views.Windows.ClientSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Select ProTanki Client"
    Width="540"
    Height="390"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                    Margin="0,0,10,0"
                    FontSize="22"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Symbol="Games24" />
                <ui:TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Select Your ProTanki Client" />
            </StackPanel>
            <ui:TextBlock
                Margin="0,8,0,0"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Choose which ProTanki client you are currently using so TextureSwapper knows where to locate and modify your game cache. You can also change this anytime in Settings."
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <ui:CardAction
                x:Name="Html5Card"
                Margin="0,0,0,12"
                Padding="14,12"
                Click="Html5Card_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton
                        x:Name="Html5Radio"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock FontWeight="SemiBold" Text="HTML5 Client" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="6,1"
                                Background="#263B82F6"
                                BorderBrush="#803B82F6"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ui:TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#60A5FA"
                                    Text="NEW" />
                            </Border>
                            <Border
                                x:Name="Html5DetectedBadge"
                                Margin="6,0,0,0"
                                Padding="6,1"
                                Background="#262ECC71"
                                BorderBrush="#802ECC71"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <ui:TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#2ECC71"
                                    Text="DETECTED" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:CardAction>

            <ui:CardAction
                x:Name="FlashCard"
                Padding="14,12"
                Click="FlashCard_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton
                        x:Name="FlashRadio"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock FontWeight="SemiBold" Text="Flash Client" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="6,1"
                                Background="#269CA3AF"
                                BorderBrush="#809CA3AF"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ui:TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FFA500"
                                    Text="DEPRECATED" />
                            </Border>
                            <Border
                                x:Name="FlashDetectedBadge"
                                Margin="6,0,0,0"
                                Padding="6,1"
                                Background="#262ECC71"
                                BorderBrush="#802ECC71"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <ui:TextBlock
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#2ECC71"
                                    Text="DETECTED" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:CardAction>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <CheckBox
                x:Name="RememberChoiceCheckBox"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="Remember my choice"
                IsChecked="True" />
            <ui:Button
                HorizontalAlignment="Right"
                Appearance="Primary"
                Click="ContinueButton_Click"
                Content="Continue"
                Icon="{ui:SymbolIcon Checkmark24}" />
        </Grid>
    </Grid>
</ui:FluentWindow>

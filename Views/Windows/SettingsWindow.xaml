<ui:FluentWindow
    x:Class="TextureSwapper.Views.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TextureSwapper.ViewModels"
    Title="Settings"
    Width="750"
    Height="650"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UIScale}" ScaleY="{Binding UIScale}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="SETTINGS"
            Grid.Row="0"
            FontFamily="{DynamicResource ActiveDisplayFont}">
            <ui:TitleBar.Header>
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{DynamicResource ActiveDisplayFont}"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="SETTINGS" />
            </ui:TitleBar.Header>
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Settings24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="20">
                <ui:TextBlock
                    Margin="0,0,0,2"
                    FontTypography="Subtitle"
                    Text="{DynamicResource Loc_Settings_PremiumLicense}" />
                <ui:TextBlock
                    Margin="0,0,0,10"
                    FontTypography="Caption"
                    Opacity="0.7"
                    Text="Manage your license key, device hardware binding (HWID), and supporter tier." />
                <ui:Card Margin="0,0,0,20" Padding="15">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsPremiumUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Padding="10,4"
                                        Background="#26FFD700"
                                        BorderBrush="#80FFD700"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <ui:TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#FFD700"
                                            Text="{Binding LicenseTierDisplay}" />
                                    </Border>
                                    <ui:TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding PremiumExpirationDisplay}"
                                        Visibility="{Binding HasExpirationDisplay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <StackPanel
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Opacity="0.75"
                                        Orientation="Horizontal"
                                        ToolTip="Verified and synchronized with Gatekeeper server">
                                        <ui:SymbolIcon
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            Symbol="CheckmarkCircle24" />
                                        <ui:TextBlock
                                            VerticalAlignment="Center"
                                            FontTypography="Caption"
                                            Text="Auto-synced" />
                                    </StackPanel>

                                    <ui:Button
                                        Appearance="Primary"
                                        Command="{Binding BuyPremiumCommand}"
                                        Content="{DynamicResource Loc_Settings_GetPremium}"
                                        Icon="{ui:SymbolIcon Cart24}"
                                        Visibility="{Binding IsTrialActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,0,0,12" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock
                                        Margin="0,0,0,4"
                                        FontTypography="Caption"
                                        Opacity="0.7"
                                        Text="License Key" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Padding="10,6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas, Courier New, monospace"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayLicenseKey}" />
                                        </Border>
                                        <ui:Button
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Padding="8,6"
                                            Appearance="Secondary"
                                            Command="{Binding ToggleKeyVisibilityCommand}"
                                            Icon="{ui:SymbolIcon Eye24}"
                                            ToolTip="Reveal / Hide Key"
                                            Visibility="{Binding IsKeyRevealed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        <ui:Button
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Padding="8,6"
                                            Appearance="Secondary"
                                            Command="{Binding ToggleKeyVisibilityCommand}"
                                            Icon="{ui:SymbolIcon EyeOff24}"
                                            ToolTip="Reveal / Hide Key"
                                            Visibility="{Binding IsKeyRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button
                                            Grid.Column="2"
                                            Margin="4,0,0,0"
                                            Padding="8,6"
                                            Appearance="Secondary"
                                            Command="{Binding CopyLicenseKeyCommand}"
                                            Icon="{ui:SymbolIcon Copy24}"
                                            ToolTip="Copy License Key" />
                                    </Grid>

                                    <ui:TextBlock
                                        Margin="0,0,0,4"
                                        FontTypography="Caption"
                                        Opacity="0.7"
                                        Text="Licensed User" />
                                    <Border
                                        Padding="10,6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <ui:TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding UserNickname}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <ui:TextBlock
                                        Margin="0,0,0,4"
                                        FontTypography="Caption"
                                        Opacity="0.7"
                                        Text="Bound Device HWID" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Padding="10,6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas, Courier New, monospace"
                                                FontSize="12"
                                                Opacity="0.85"
                                                Text="{Binding ShortDeviceHardwareId}"
                                                ToolTip="{Binding DeviceHardwareId}" />
                                        </Border>
                                        <ui:Button
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Padding="8,6"
                                            Appearance="Secondary"
                                            Command="{Binding CopyHardwareIdCommand}"
                                            Icon="{ui:SymbolIcon Copy24}"
                                            ToolTip="Copy Machine Hardware ID" />
                                    </Grid>

                                    <ui:TextBlock
                                        Margin="0,0,0,4"
                                        FontTypography="Caption"
                                        Opacity="0.7"
                                        Text="Security &amp; Integrity" />
                                    <Border
                                        Padding="10,6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="#2ECC71"
                                                Symbol="ShieldCheckmark24" />
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Opacity="0.85"
                                                Text="RSA-256 Verified • " />
                                            <ui:TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Opacity="0.85"
                                                Text="{Binding LastVerifiedDisplay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsPremiumLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                    <ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc_Settings_LicenseStatus}" />
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Opacity="0.6"
                                        Text="{DynamicResource Loc_Settings_LicenseStatusDesc}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <ui:Button
                                        Appearance="Primary"
                                        Command="{Binding BuyPremiumCommand}"
                                        Content="{DynamicResource Loc_Settings_GetPremium}"
                                        Icon="{ui:SymbolIcon Cart24}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Appearance="Success"
                                        Command="{Binding StartFreeTrialCommand}"
                                        Content="{DynamicResource Loc_Settings_StartFreeTrial}"
                                        Icon="{ui:SymbolIcon Sparkle24}"
                                        Visibility="{Binding CanStartTrial, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Padding="10,6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:TextBlock
                                            VerticalAlignment="Center"
                                            FontTypography="Caption"
                                            Opacity="0.7"
                                            Text="Your Machine HWID: " />
                                        <ui:TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas, Courier New, monospace"
                                            FontSize="12"
                                            Text="{Binding ShortDeviceHardwareId}"
                                            ToolTip="{Binding DeviceHardwareId}" />
                                    </StackPanel>
                                </Border>
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Appearance="Secondary"
                                    Command="{Binding CopyHardwareIdCommand}"
                                    Content="Copy HWID"
                                    Icon="{ui:SymbolIcon Copy24}" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox PlaceholderText="Nickname" Text="{Binding UserNickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Appearance="Secondary"
                                    Command="{Binding UseWindowsUsernameCommand}"
                                    Content="Use PC Name" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox PlaceholderText="{DynamicResource Loc_Settings_LicenseKeyPlaceholder}" Text="{Binding PremiumLicenseKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Appearance="Primary"
                                    Command="{Binding ActivatePremiumCommand}"
                                    Content="Activate"
                                    Icon="{ui:SymbolIcon Key24}" />
                            </Grid>

                            <ui:TextBlock
                                Margin="0,5,0,0"
                                FontTypography="Caption"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ActivationStatusText}"
                                Visibility="{Binding ActivationStatusText, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:TextBlock
                    Margin="0,0,0,2"
                    FontTypography="Subtitle"
                    Text="Backups" />
                <ui:TextBlock
                    Margin="0,0,0,10"
                    FontTypography="Caption"
                    Opacity="0.7"
                    Text="Configure automated retention periods for texture rollbacks and file safeguards." />
                <ui:Card Margin="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontWeight="SemiBold" Text="Max Backup Retention" />
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Opacity="0.6"
                                    Text="Automatically delete backups older than these days" />
                            </StackPanel>
                            <ui:NumberBox
                                Grid.Column="1"
                                MinWidth="100"
                                Maximum="365"
                                Minimum="1"
                                Value="{Binding BackupRetentionDays, Mode=TwoWay}" />
                        </Grid>
                        <Slider
                            Margin="0,10,0,0"
                            IsSnapToTickEnabled="True"
                            Maximum="365"
                            Minimum="1"
                            TickFrequency="1"
                            Value="{Binding BackupRetentionDays, Mode=TwoWay}" />
                    </StackPanel>
                </ui:Card>

                <ui:TextBlock
                    Margin="0,15,0,2"
                    FontTypography="Subtitle"
                    Text="Appearance &amp; Display" />
                <ui:TextBlock
                    Margin="0,0,0,10"
                    FontTypography="Caption"
                    Opacity="0.7"
                    Text="Configure theme, window scaling, and desktop visual aesthetics." />
                <ui:Card Margin="0,0,0,20" Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontWeight="SemiBold" Text="Application Theme" />
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Opacity="0.6"
                                    Text="Select the application's theme" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="150"
                                ItemsSource="{Binding AvailableThemes}"
                                SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontWeight="SemiBold" Text="UI Scaling / Zoom" />
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Opacity="0.6"
                                    Text="Adjust the size of application interface elements" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Slider
                                    Width="120"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="1.3"
                                    Minimum="0.7"
                                    TickFrequency="0.05"
                                    Value="{Binding UIScale, Mode=TwoWay}" />
                                <ui:TextBlock
                                    Width="40"
                                    VerticalAlignment="Center"
                                    Text="{Binding UIScale, StringFormat={}{0:P0}}"
                                    TextAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:TextBlock
                    Margin="0,15,0,10"
                    FontTypography="Subtitle"
                    Text="🎃 Halloween Seasonal Customization"
                    Visibility="{Binding IsHalloweenCustomizationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:Card
                    Margin="0,0,0,20"
                    Padding="15"
                    Visibility="{Binding IsHalloweenCustomizationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <ui:TextBlock
                            Margin="0,0,0,10"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="VISUAL EFFECTS" />

                        <Border
                            Margin="0,0,0,15"
                            Padding="12,10"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Margin="0,2,10,0"
                                    VerticalAlignment="Top"
                                    FontSize="16"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="Info24" />
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock FontWeight="SemiBold" Text="Resource Usage" />
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Opacity="0.75"
                                        Text="The Halloween theme renders real-time visual effects. It actively uses your GPU and a bit more CPU and RAM to keep animations smooth!"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,5,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontWeight="SemiBold" Text="Animated Atmosphere" />
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Opacity="0.6"
                                    Text="Canvas animation with floating bats, embers, wandering spirits, and glowing eyes" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableHalloweenAtmosphereAnimation, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontWeight="SemiBold" Text="Gothic Display Font" />
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Opacity="0.6"
                                    Text="Use the halloween font on headers and navigation tabs" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableHalloweenSpookyFont, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontWeight="SemiBold" Text="Seasonal Title &amp; Icon" />
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Opacity="0.6"
                                    Text="Display 🎃 pumpkin logo and seasonal icon in the title bar" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableHalloweenAppLogo, Mode=TwoWay}" />
                        </Grid>

                        <Border
                            Height="1"
                            Margin="0,5,0,15"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            Opacity="0.4" />

                        <ui:TextBlock
                            Margin="0,0,0,10"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="AUDIO &amp; AMBIENCE" />

                        <Grid Margin="0,5,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontWeight="SemiBold" Text="Master Spooky Audio" />
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Opacity="0.6"
                                    Text="Enable eerie sounds, button bone-clicks, ambient drone, and Easter egg effects" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableHalloweenSound, Mode=TwoWay}" />
                        </Grid>

                        <Grid Margin="0,0,0,5" IsEnabled="{Binding EnableHalloweenSound}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontWeight="SemiBold" Text="Random Ambient Scares" />
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Opacity="0.6"
                                    Text="Occasional ghost wails, laughs, and monster roars in the background" />
                            </StackPanel>
                            <ui:ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding EnableHalloweenRandomScares, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:TextBlock
                    Margin="0,15,0,2"
                    FontTypography="Subtitle"
                    Text="Updates" />
                <ui:TextBlock
                    Margin="0,0,0,10"
                    FontTypography="Caption"
                    Opacity="0.7"
                    Text="Track currently installed application versions and check official releases." />
                <ui:Card Margin="0,0,0,20" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontWeight="SemiBold" Text="Software Updates" />
                                <ui:TextBlock
                                    FontTypography="Caption"
                                    Opacity="0.6"
                                    Text="Automatic checking against the official GitHub releases repository" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                Appearance="Primary"
                                Command="{Binding CheckForUpdatesCommand}"
                                Content="Check for Updates"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                        </Grid>

                        <Border
                            Padding="12,10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="10,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Opacity="0.6"
                                        Text="INSTALLED VERSION" />
                                    <ui:TextBlock
                                        Margin="0,4,0,0"
                                        FontWeight="SemiBold"
                                        Text="{Binding AppVersion}" />
                                </StackPanel>

                                <Rectangle
                                    Grid.Column="1"
                                    Fill="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Opacity="0.5" />

                                <StackPanel Grid.Column="2" Margin="10,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Opacity="0.6"
                                        Text="LATEST ON GITHUB" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <ui:TextBlock FontWeight="SemiBold" Text="{Binding LatestGitHubVersion}" />
                                        <Border
                                            Margin="6,0,0,0"
                                            Padding="6,2"
                                            Background="#262ECC71"
                                            BorderBrush="#802ECC71"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <ui:TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="#2ECC71"
                                                Text="{Binding LatestVersionPill}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle
                                    Grid.Column="3"
                                    Fill="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Opacity="0.5" />

                                <StackPanel Grid.Column="4" Margin="10,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Opacity="0.6"
                                        Text="STATUS" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <ui:TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            Text="{Binding EngineStateDisplay}" />
                                        <ui:ProgressRing
                                            Width="14"
                                            Height="14"
                                            Margin="6,0,0,0"
                                            IsIndeterminate="True"
                                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle
                                    Grid.Column="5"
                                    Fill="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Opacity="0.5" />

                                <StackPanel Grid.Column="6" Margin="10,0">
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Opacity="0.6"
                                        Text="LAST CHECKED" />
                                    <ui:TextBlock
                                        Margin="0,4,0,0"
                                        Opacity="0.8"
                                        Text="{Binding LastCheckedTime}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <ui:TextBlock
                    Margin="0,15,0,2"
                    FontTypography="Subtitle"
                    Text="Application Logs" />
                <ui:TextBlock
                    Margin="0,0,0,10"
                    FontTypography="Caption"
                    Opacity="0.7"
                    Text="Inspect diagnostic logs and engine telemetry for troubleshooting." />
                <ui:Card Margin="0,0,0,20" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                Grid.Column="1"
                                Margin="0,0,10,0"
                                Command="{Binding OpenLogsFolderCommand}"
                                Content="Open Folder"
                                Icon="{ui:SymbolIcon Folder24}" />
                            <ui:Button
                                Grid.Column="2"
                                Command="{Binding RefreshLogsCommand}"
                                Content="Refresh"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                        </Grid>

                        <ScrollViewer
                            Grid.Row="0"
                            Height="200"
                            Padding="0,0,15,15"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <TextBox
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Consolas, Courier New"
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                IsReadOnly="True"
                                Text="{Binding LogContent, Mode=OneWay}"
                                TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="LoadingOverlay"
            Grid.RowSpan="2"
            Panel.ZIndex="10000"
            Background="#F0000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing
                    Width="60"
                    Height="40"
                    IsIndeterminate="True" />
                <ui:TextBlock
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    FontTypography="Subtitle"
                    Foreground="White"
                    Text="{Binding UpdateStatus}" />
            </StackPanel>
        </Grid>
        <ui:InfoBar
            x:Name="ToastInfoBar"
            Grid.RowSpan="2"
            MaxWidth="350"
            Margin="0,20,20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="1000"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</ui:FluentWindow>

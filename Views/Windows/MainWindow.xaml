<ui:FluentWindow
    x:Class="TextureSwapper.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TextureSwapper.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:TextureSwapper.Helpers.Converters"
    xmlns:local="clr-namespace:TextureSwapper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TextureSwapper.ViewModels"
    xmlns:windows="clr-namespace:TextureSwapper.Views.Windows"
    Title="{DynamicResource Loc_AppName}"
    Width="1400"
    Height="900"
    MinWidth="1000"
    MinHeight="500"
    d:DataContext="{d:DesignInstance vm:MainViewModel,
                                     IsDesignTimeCreatable=False}"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UIScale}" ScaleY="{Binding UIScale}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="{Binding AppTitleText, FallbackValue='🎃 ProTanki Texture Swapper 🎃'}"
            Height="46"
            VerticalAlignment="Center"
            FontFamily="{DynamicResource ActiveDisplayFont}"
            FontSize="15"
            FontWeight="Bold">
            <ui:TitleBar.Header>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Margin="0,-4,10,-4"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        PreviewMouseLeftButtonDown="OnLogoMouseDown">
                        <Image
                            Width="32"
                            Height="32"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding AppLogoSource, FallbackValue='pack://application:,,,/Assets/logo.png'}" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{DynamicResource ActiveDisplayFont}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding AppTitleText, FallbackValue='🎃 ProTanki Texture Swapper 🎃'}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:HalloweenAtmosphereCanvas
                Grid.ColumnSpan="2"
                Panel.ZIndex="0"
                Visibility="{Binding IsHalloweenAtmosphereVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ui:NavigationView
                x:Name="RootNavigation"
                Grid.Column="0"
                FontFamily="{DynamicResource ActiveDisplayFont}"
                FontSize="15"
                IsBackButtonVisible="Collapsed"
                OpenPaneLength="250"
                PaneDisplayMode="Left">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        Click="OnNavigationItemClick"
                        Content="{Binding NavSkinsText, FallbackValue='Skins'}"
                        FontFamily="{DynamicResource ActiveDisplayFont}"
                        FontSize="15"
                        Icon="{ui:SymbolIcon Cube24}"
                        IsActive="True"
                        Tag="Skins" />
                    <ui:NavigationViewItem
                        Click="OnNavigationItemClick"
                        Content="{Binding NavPaintsText, FallbackValue='Paints'}"
                        FontFamily="{DynamicResource ActiveDisplayFont}"
                        FontSize="15"
                        Icon="{ui:SymbolIcon PaintBrush24}"
                        Tag="Paints" />
                    <ui:NavigationViewItem
                        Click="OnNavigationItemClick"
                        Content="{Binding NavBackupsText, FallbackValue='Backup History'}"
                        FontFamily="{DynamicResource ActiveDisplayFont}"
                        FontSize="15"
                        Icon="{ui:SymbolIcon History24}"
                        Tag="Backups" />
                    <ui:NavigationViewItem
                        Click="OnNavigationItemClick"
                        Content="{Binding NavShotEffectsText, FallbackValue='Shot Effects'}"
                        FontFamily="{DynamicResource ActiveDisplayFont}"
                        FontSize="15"
                        Icon="{ui:SymbolIcon Flash24}"
                        Tag="ShotEffects" />
                    <ui:NavigationViewItem
                        Click="OnParachuteEditorNavItemClick"
                        Content="{Binding NavParachutesText, FallbackValue='Parachute Editor'}"
                        FontFamily="{DynamicResource ActiveDisplayFont}"
                        FontSize="15"
                        Icon="{ui:SymbolIcon Tag24}"
                        Tag="ParachuteEditor" />
                    <ui:NavigationViewItem
                        Click="OnPropsEditorNavItemClick"
                        Content="{Binding NavPropsText, FallbackValue='Props Editor'}"
                        FontFamily="{DynamicResource ActiveDisplayFont}"
                        FontSize="15"
                        Icon="{ui:SymbolIcon Building24}"
                        Tag="PropsEditor" />
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem
                        Click="OnAdminNavItemClick"
                        Content="{Binding NavAdminText, FallbackValue='Admin Panel'}"
                        FontFamily="{DynamicResource ActiveDisplayFont}"
                        FontSize="15"
                        Icon="{ui:SymbolIcon Key24}"
                        Tag="Admin" />
                    <ui:NavigationViewItem
                        Click="OnNavigationItemClick"
                        Content="{Binding NavSettingsText, FallbackValue='Settings'}"
                        FontFamily="{DynamicResource ActiveDisplayFont}"
                        FontSize="15"
                        Icon="{ui:SymbolIcon Settings24}"
                        Tag="Settings" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <Grid Grid.Column="1" Margin="20,10,20,20">
                <TabControl
                    x:Name="MainTabControl"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectedIndex="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabItem Header="{DynamicResource Loc_Tab_Skins}">
                        <controls:SkinsTabContent DataContext="{Binding SkinsTabVM}" />
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc_Tab_Paints}">
                        <controls:PaintsTabContent DataContext="{Binding PaintsTabVM}" />
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc_Tab_BackupHistory}">
                        <controls:BackupsTabContent DataContext="{Binding BackupsTabVM}" />
                    </TabItem>

                    <TabItem Header="{DynamicResource Loc_Tab_ShotEffects}">
                        <controls:ShotEffectsTabContent DataContext="{Binding ShotEffectsTabVM}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <controls:DeviceBannedOverlayControl
            Grid.RowSpan="2"
            Panel.ZIndex="99999"
            Visibility="{Binding IsDeviceBanned, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <controls:AdminOverlayControl
            x:Name="AdminOverlay"
            Grid.RowSpan="2"
            Panel.ZIndex="9999"
            Visibility="Collapsed" />

        <Grid
            x:Name="LoadingOverlay"
            Grid.RowSpan="2"
            Panel.ZIndex="10000"
            Background="#E50B0B0B">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing
                    Width="80"
                    Height="60"
                    IsIndeterminate="True" />
                <ui:TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontTypography="Title"
                    Foreground="White"
                    Text="{Binding UpdateStatus}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            MaxWidth="380"
            Margin="0,20,20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="2000"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1.5"
            CornerRadius="8"
            Visibility="{Binding IsOpen, ElementName=ToastInfoBar, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="270"
                    Opacity="0.65"
                    ShadowDepth="4"
                    Color="Black" />
            </Border.Effect>
            <ui:InfoBar
                x:Name="ToastInfoBar"
                Background="Transparent"
                BorderThickness="0"
                IsClosable="False"
                IsOpen="False" />
        </Border>
    </Grid>
</ui:FluentWindow>

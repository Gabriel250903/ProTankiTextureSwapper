<ui:FluentWindow
  x:Class="TextureSwapper.Views.Windows.ParachuteEditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:TextureSwapper.Views.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:helpers="clr-namespace:TextureSwapper.Helpers.Converters"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:TextureSwapper.ViewModels.Editors"
  Title="{DynamicResource Loc_Parachute_Title}"
  Width="950"
  Height="800"
  MinWidth="950"
  MinHeight="800"
  d:DataContext="{d:DesignInstance vm:ParachuteEditorViewModel}"
  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowStartupLocation="CenterOwner"
  mc:Ignorable="d"
>
  <ui:FluentWindow.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>
      <helpers:ImageThumbnailConverter x:Key="ImageThumbnailConverter" />
    </ResourceDictionary>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="{DynamicResource Loc_Parachute_Title}" Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="PaintBrush24" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <Grid Grid.Row="1" Margin="10,20,10,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="480" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border
        Grid.Column="0"
        Margin="0,0,15,0"
        Padding="15"
        Background="{DynamicResource ControlFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="16"
      >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <ui:TextBlock
            Grid.Row="0"
            Margin="0,0,0,15"
            FontTypography="Subtitle"
            FontWeight="SemiBold"
            Text="{DynamicResource Loc_Parachute_LivePreview}"
          />

          <Border
            Grid.Row="1"
            Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#1E1E1E"
            BorderBrush="{DynamicResource SystemAccentColorBrush}"
            BorderThickness="2"
            CornerRadius="12"
          >
            <Image Width="420" Height="420" Source="{Binding RenderedPreview}" Stretch="Uniform" />
          </Border>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,20,0">
          <ui:TextBlock
            Margin="0,0,0,10"
            FontTypography="Subtitle"
            Text="{DynamicResource Loc_Parachute_ImageSource}"
          />
          <ui:Card Margin="0,0,0,15" Padding="12">
            <StackPanel>
              <ui:Button
                HorizontalAlignment="Stretch"
                Appearance="Primary"
                Command="{Binding BrowseImageCommand}"
                Content="{DynamicResource Loc_Parachute_ImportCustomImage}"
                Icon="{ui:SymbolIcon Folder24}"
              />

              <ui:TextBlock
                Margin="0,12,0,6"
                FontTypography="Caption"
                Opacity="0.6"
                Text="{DynamicResource Loc_Parachute_OrSelectExisting}"
              />

              <ui:TextBox
                Margin="0,0,0,8"
                ClearButtonEnabled="True"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{DynamicResource Loc_Parachute_SearchExistingPaints}"
                Text="{Binding PaintSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              />

              <Border
                Height="200"
                Padding="4"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
              >
                <ListBox
                  Background="Transparent"
                  BorderThickness="0"
                  ItemsSource="{Binding FilteredPaints}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectedItem="{Binding SelectedPaint, Mode=TwoWay}"
                >
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                          Width="34"
                          Height="34"
                          Margin="0,0,10,0"
                          ClipToBounds="True"
                          CornerRadius="6"
                        >
                          <Image
                            Source="{Binding PreviewImage, Converter={StaticResource ImageThumbnailConverter}}"
                            Stretch="UniformToFill"
                          />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <ui:TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                          />
                          <ui:TextBlock
                            FontTypography="Caption"
                            Opacity="0.5"
                            Text="{Binding ItemName}"
                            TextTrimming="CharacterEllipsis"
                          />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </StackPanel>
          </ui:Card>

          <Grid Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock
              VerticalAlignment="Center"
              FontTypography="Subtitle"
              Text="{DynamicResource Loc_Parachute_TransformControls}"
            />
            <ui:Button
              Grid.Column="1"
              Appearance="Secondary"
              Command="{Binding ResetTransformCommand}"
              Content="{DynamicResource Loc_Parachute_ResetAll}"
              Icon="{ui:SymbolIcon ArrowReset24}"
            />
          </Grid>
          <ui:Card Margin="0,0,0,20" Padding="10">
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock FontWeight="SemiBold" Text="{DynamicResource Loc_Parachute_Scale}" />
                <ui:TextBlock
                  Grid.Column="1"
                  Opacity="0.7"
                  Text="{Binding Scale, StringFormat={}{0:F2}x}"
                />
              </Grid>
              <Slider
                IsSnapToTickEnabled="False"
                Maximum="25.0"
                Minimum="0.1"
                SmallChange="0.05"
                Value="{Binding Scale, Mode=TwoWay}"
              />

              <Grid Margin="0,15,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock
                  FontWeight="SemiBold"
                  Text="{DynamicResource Loc_Parachute_OffsetX}"
                />
                <ui:TextBlock
                  Grid.Column="1"
                  Opacity="0.7"
                  Text="{Binding OffsetX, StringFormat={}{0:F0}px}"
                />
              </Grid>
              <Slider
                IsSnapToTickEnabled="False"
                Maximum="300"
                Minimum="-300"
                Value="{Binding OffsetX, Mode=TwoWay}"
              />

              <Grid Margin="0,15,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock
                  FontWeight="SemiBold"
                  Text="{DynamicResource Loc_Parachute_OffsetY}"
                />
                <ui:TextBlock
                  Grid.Column="1"
                  Opacity="0.7"
                  Text="{Binding OffsetY, StringFormat={}{0:F0}px}"
                />
              </Grid>
              <Slider
                IsSnapToTickEnabled="False"
                Maximum="300"
                Minimum="-300"
                Value="{Binding OffsetY, Mode=TwoWay}"
              />

              <Grid Margin="0,15,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock
                  FontWeight="SemiBold"
                  Text="{DynamicResource Loc_Parachute_RotationAngle}"
                />
                <ui:TextBlock
                  Grid.Column="1"
                  Opacity="0.7"
                  Text="{Binding RotationAngle, StringFormat={}{0:F0}°}"
                />
              </Grid>
              <Slider
                IsSnapToTickEnabled="False"
                Maximum="360"
                Minimum="0"
                Value="{Binding RotationAngle, Mode=TwoWay}"
              />

              <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <ui:TextBlock
                    FontWeight="SemiBold"
                    Text="{DynamicResource Loc_Parachute_RepeatPattern}"
                  />
                  <ui:TextBlock
                    FontTypography="Caption"
                    Opacity="0.6"
                    Text="{DynamicResource Loc_Parachute_TileImage}"
                  />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding TileMode, Mode=TwoWay}" />
              </Grid>
            </StackPanel>
          </ui:Card>

          <ui:TextBlock
            Margin="0,5,0,8"
            FontTypography="Subtitle"
            Text="{DynamicResource Loc_Parachute_Name}"
          />
          <ui:Card Margin="0,0,0,15" Padding="12">
            <ui:TextBox
              Icon="{ui:SymbolIcon Edit24}"
              PlaceholderText="{DynamicResource Loc_Parachute_NamePlaceholder}"
              Text="{Binding ParachuteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            />
          </ui:Card>

          <StackPanel Orientation="Vertical">
            <ui:Button
              Margin="0,0,0,10"
              Padding="0,10"
              HorizontalAlignment="Stretch"
              Appearance="Success"
              Command="{Binding ApplyAndSwapCommand}"
              Content="{DynamicResource Loc_Parachute_ApplyAndSwap}"
              FontSize="15"
              FontWeight="Bold"
              Icon="{ui:SymbolIcon CheckmarkCircle24}"
            />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Appearance="Secondary"
                Command="{Binding ResetTransformCommand}"
                Content="{DynamicResource Loc_Parachute_Reset}"
                Icon="{ui:SymbolIcon ArrowReset24}"
              />
              <ui:Button
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Appearance="Secondary"
                Command="{Binding ExportImageCommand}"
                Content="{DynamicResource Loc_Parachute_ExportJpg}"
                Icon="{ui:SymbolIcon Save24}"
              />
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <controls:PremiumLockOverlayControl
        Grid.ColumnSpan="2"
        Panel.ZIndex="9999"
        FeatureTitle="{DynamicResource Loc_Parachute_Title}"
        IsLocked="{Binding IsPremiumLocked}"
      />
    </Grid>

    <ui:InfoBar
      x:Name="ToastInfoBar"
      Grid.Row="1"
      Margin="20"
      HorizontalAlignment="Center"
      VerticalAlignment="Bottom"
      Panel.ZIndex="10000"
      IsOpen="False"
    />
  </Grid>
</ui:FluentWindow>
